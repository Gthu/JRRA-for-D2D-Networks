#include <algorithm>
#include <cmath>
#include <cstddef>
#include <map>
#include <numeric>
#include <set>
#include <vector>

#include "graph.h"

// ==========================================
// Keep-Alive Epsilon Constants
// ==========================================
constexpr double kEpsilonPowerWatts = 1e-13;        // -100 dBm = 0.1 pW (Maintains connectivity without interference)
constexpr double kEpsilonBandwidthRatio = 1e-6;     // Fractional bandwidth reservation for inactive links

/**
 * @brief Initializes physical resources (power and bandwidth) using a strict Keep-Alive strategy.
 * * @param graph The complete network topology graph.
 * @param active_subgraph The logical subset of active links computed via routing algorithms (e.g., KSP).
 * @param node_max_powers Vector containing the maximum transmission power budget for each node.
 * @param total_bandwidth_mhz The physical limit of total available spectrum in the system.
 * @return InitialAllocation Structure containing the safely initialized active edges, power, and bandwidth mappings.
 * * @note This strategy prevents gradient vanishing and log(0) singularities in barrier-based optimization 
 * solvers (like IPM). It allocates the majority of resources to active links while injecting an infinitesimally 
 * small \epsilon resource to inactive links. Includes mathematical safeguards against budget overflow and 
 * zero-division faults. Time complexity is bounded by O(V + E).
 */
InitialAllocation initialize_resources(
    const Graph& graph,                
    const std::set<Link>& active_subgraph, 
    const std::vector<double>& node_max_powers,
    double total_bandwidth_mhz
) {
    InitialAllocation result;
    result.active_edges = active_subgraph; 

    std::size_t num_nodes = node_max_powers.size(); 

    // ==========================================
    // Phase 1: Initial Power Allocation (Watts)
    // ==========================================
    for (std::size_t u = 0; u < num_nodes; ++u) {
        std::vector<int> active_neighbors;
        std::vector<int> inactive_neighbors;

        if (u < graph.adj.size()) {
            for (const auto& edge : graph.adj[u]) {
                int v = edge.first;
                Link current_link = { static_cast<int>(u), v };

                if (result.active_edges.count(current_link)) {
                    active_neighbors.push_back(v);
                } else {
                    inactive_neighbors.push_back(v);
                }
            }
        }

        double total_node_power = node_max_powers[u];
        std::size_t active_count = active_neighbors.size();
        std::size_t inactive_count = inactive_neighbors.size();
        std::size_t total_degree = active_count + inactive_count;

        if (total_degree == 0) {
            continue; // Isolated node bypass
        }

        // --- Allocation Logic Branching ---

        // Case A: Node has no active outgoing links.
        // Strategy: Provide epsilon to all physical links to maintain gradient pathways.
        if (active_count == 0) {
            for (int v : inactive_neighbors) {
                result.initial_power[{static_cast<int>(u), v}] = kEpsilonPowerWatts;
            }
        } 
        // Case B: Normal operation (Node has active links).
        else {
            double reserved_inactive_power = static_cast<double>(inactive_count) * kEpsilonPowerWatts;

            // Budget Audit: Fallback to uniform distribution if epsilon reservation exceeds total budget (extreme edge case)
            if (reserved_inactive_power >= total_node_power) {
                double fallback_power_per_link = total_node_power / static_cast<double>(total_degree);
                for (int v : active_neighbors) result.initial_power[{static_cast<int>(u), v}] = fallback_power_per_link;
                for (int v : inactive_neighbors) result.initial_power[{static_cast<int>(u), v}] = fallback_power_per_link;
            } else {
                // Standard Keep-Alive Allocation
                double remaining_power = total_node_power - reserved_inactive_power;
                double power_per_active_link = remaining_power / static_cast<double>(active_count);

                for (int v : active_neighbors) {
                    result.initial_power[{static_cast<int>(u), v}] = power_per_active_link;
                }
                for (int v : inactive_neighbors) {
                    result.initial_power[{static_cast<int>(u), v}] = kEpsilonPowerWatts;
                }
            }
        }
    }

    // ==========================================
    // Phase 2: Initial Bandwidth Allocation (MHz)
    // ==========================================
    std::size_t total_active_links = result.active_edges.size();
    std::size_t total_inactive_links = 0;

    // Fast census of inactive links across the topology
    for (std::size_t u = 0; u < num_nodes; ++u) {
        if (u < graph.adj.size()) {
            for (const auto& edge : graph.adj[u]) {
                int v = edge.first;
                if (result.active_edges.find({ static_cast<int>(u), v }) == result.active_edges.end()) {
                    total_inactive_links++;
                }
            }
        }
    }

    double epsilon_bandwidth = total_bandwidth_mhz * kEpsilonBandwidthRatio;
    double total_reserved_bandwidth = static_cast<double>(total_inactive_links) * epsilon_bandwidth;

    double active_link_bandwidth = 0.0;
    double inactive_link_bandwidth = 0.0;

    // Budget Audit: Guard against network-wide bandwidth starvation
    if (total_reserved_bandwidth >= total_bandwidth_mhz) {
        std::size_t total_links = total_active_links + total_inactive_links;
        double uniform_bandwidth = total_bandwidth_mhz / static_cast<double>(total_links > 0 ? total_links : 1);
        active_link_bandwidth = uniform_bandwidth;
        inactive_link_bandwidth = uniform_bandwidth;
    } else {
        inactive_link_bandwidth = epsilon_bandwidth;
        if (total_active_links > 0) {
            active_link_bandwidth = (total_bandwidth_mhz - total_reserved_bandwidth) / static_cast<double>(total_active_links);
        } else {
            active_link_bandwidth = 0.0; // Fail-safe
        }
    }

    // Physical Mapping: Assign computed bandwidths globally
    for (std::size_t u = 0; u < num_nodes; ++u) {
        if (u < graph.adj.size()) {
            for (const auto& edge : graph.adj[u]) {
                int v = edge.first;
                Link current_link = { static_cast<int>(u), v };

                if (result.active_edges.count(current_link)) {
                    result.initial_bandwidth[current_link] = active_link_bandwidth;
                } else {
                    result.initial_bandwidth[current_link] = inactive_link_bandwidth;
                }
            }
        }
    }

    return result;
}
