/**
 * @brief Computes the shortest path under dynamic, real-time edge penalties.
 * @param graph The underlying network topology for connectivity references.
 * @param num_nodes Total vertices in the graph.
 * @param source_node The origin node index.
 * @param target_node The destination node index.
 * @param dynamic_weights The dynamically updated penalty/cost mapping for active and potential links.
 * @return std::vector<Link> The sequence of edges forming the optimal path.
 * @note Operates as the linear optimization oracle within the Frank-Wolfe algorithm. 
 * Incorporates a robust physical-fallback mechanism: if a physical edge lacks a mapped weight, 
 * it is assigned an extreme penalty (1e9) rather than being disconnected, preventing zero-flow deadlocks 
 * while heavily discouraging its use. Time complexity: O(E + V \log V).
 */
std::vector<Link> dijkstra_weighted(
    const Graph& graph,
    std::size_t num_nodes,
    int source_node,
    int target_node,
    const std::map<Link, double>& dynamic_weights
) {
    std::vector<double> min_distances(num_nodes, std::numeric_limits<double>::max());
    std::vector<int> predecessors(num_nodes, -1);

    using PII = std::pair<double, int>;
    std::priority_queue<PII, std::vector<PII>, std::greater<PII>> priority_queue;

    min_distances[source_node] = 0.0;
    priority_queue.push({ 0.0, source_node });

    const double kInfinitePenalty = 1e9;

    while (!priority_queue.empty()) {
        double current_distance = priority_queue.top().first;
        int u = priority_queue.top().second;
        priority_queue.pop();

        if (current_distance > min_distances[u]) continue;
        if (u == target_node) break;

        if (u < graph.adj.size()) {
            for (const auto& edge : graph.adj[u]) {
                int v = edge.first; 
                if (v >= num_nodes) continue;

                Link current_link = { u, v }; 

                double link_weight;

                // === [Robustness Injection: Directed Graph Safety] ===
                if (dynamic_weights.count(current_link)) {
                    link_weight = dynamic_weights.at(current_link);
                } else {
                    // Critical fallback: Preserve physical connectivity to prevent solver crashes.
                    // Assign a massive penalty so Dijkstra only utilizes this link if absolutely necessary.
                    link_weight = kInfinitePenalty;
                }
                // ====================================================

                if (min_distances[u] + link_weight < min_distances[v]) {
                    min_distances[v] = min_distances[u] + link_weight;
                    predecessors[v] = u;
                    priority_queue.push({ min_distances[v], v });
                }
            }
        }
    }

    std::vector<Link> optimal_path;
    if (min_distances[target_node] == std::numeric_limits<double>::max()) {
        return optimal_path; 
    }

    int current_vertex = target_node;
    while (current_vertex != source_node) {
        int previous_vertex = predecessors[current_vertex];
        if (previous_vertex == -1) break;
        optimal_path.push_back({ previous_vertex, current_vertex });
        current_vertex = previous_vertex;
    }
    std::reverse(optimal_path.begin(), optimal_path.end());

    return optimal_path;
}

/**
 * @brief Computes the Log-Sum-Exp (LSE) stabilized softmax weights.
 * @param commodity_delays The vector of expected delays for all commodity paths.
 * @param lse_smoothing_parameter The $\mu$ parameter controlling the approximation strictness.
 * @return std::vector<double> The stabilized gradient coefficients ($\beta_k$).
 * @note Mitigates numerical overflow by shifting the exponentiated values by the maximum delay.
 */
std::vector<double> calculate_softmax_beta(const std::vector<double>& commodity_delays, double lse_smoothing_parameter) {
    std::vector<double> softmax_weights(commodity_delays.size());
    if (commodity_delays.empty()) return softmax_weights;

    double max_delay = *std::max_element(commodity_delays.begin(), commodity_delays.end());

    double sum_exponentials = 0.0;
    for (double t : commodity_delays) {
        sum_exponentials += std::exp(lse_smoothing_parameter * (t - max_delay));
    }

    for (std::size_t k = 0; k < commodity_delays.size(); ++k) {
        softmax_weights[k] = std::exp(lse_smoothing_parameter * (commodity_delays[k] - max_delay)) / sum_exponentials;
    }
    
    return softmax_weights;
}

// =========================================================
// Frank-Wolfe Optimization Solver (Part 1)
// =========================================================

void solve_frank_wolfe(
    const Graph& graph,
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& network_edges,
    std::size_t num_nodes,
    std::set<Link>& active_edges,
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& commodity_demands,
    const LinkMap& rate_capacities,
    const LinkMap& power_allocations,
    std::vector<std::map<Link, double>>& flow_routing_matrix,
    FWConfig config,
    const std::map<Link, double>& dynamic_edge_weights
) {
    // Note: config.alpha is functionally mapping to the tradeoff/fairness parameter here based on your math.
    std::cout << "\n>>> Invoke Frank-Wolfe solver (mu=" << config.penalty_multiplier 
              << ", alpha=" << config.step_size_alpha << ") <<<\n";

    if (rate_capacities.empty()) {
        std::cerr << "[Fatal Error] rate_capacities (r0) map is empty! FW aborted.\n";
        return;
    }

    int current_iteration = 1;
    double previous_objective_value = std::numeric_limits<double>::max();
    double previous_duality_gap = std::numeric_limits<double>::max();

    double minimum_duality_gap = std::numeric_limits<double>::max();
    std::vector<std::map<Link, double>> best_flow_routing_matrix = flow_routing_matrix;
    double best_objective_value = std::numeric_limits<double>::max();
    int best_iteration_index = -1; 
    std::string termination_reason = "Max Iter reached"; 
    
    constexpr double kVirtualCapacityFallback = 0.01; 

    while (current_iteration <= config.max_iterations) {

        // =========================================================
        // Step 0 & 1: State Evaluation & Gradient Computation
        // =========================================================
        std::vector<double> commodity_delays(commodity_demands.size(), 0.0);
        double total_energy_penalty = 0.0; 
        std::map<Link, double> aggregate_link_flows;

        for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
            double traffic_volume = std::get<2>(commodity_demands[k]);
            for (const auto& pair : flow_routing_matrix[k]) {
                Link current_link = pair.first;
                double flow_fraction = pair.second;
                
                if (flow_fraction < 1e-9) continue;
                
                double real_rate = rate_capacities.count(current_link) ? rate_capacities.at(current_link) : 1e-9;
                double safe_rate = std::max(real_rate, kVirtualCapacityFallback);
                double allocated_power = (power_allocations.count(current_link)) ? power_allocations.at(current_link) : 0.0;

                commodity_delays[k] += flow_fraction * (traffic_volume / safe_rate);
                total_energy_penalty += flow_fraction * (1.0 - config.step_size_alpha) * traffic_volume * (allocated_power / safe_rate);
                aggregate_link_flows[current_link] += flow_fraction * traffic_volume;
            }
        }

        // ---------------------------------------------------------
        // Integral Objective Correction for the Congestion Penalty
        // Gradient: c * (f_e / r) -> Integral: 0.5 * c * (f_e^2 / r)
        // ---------------------------------------------------------
        constexpr double kMultipathSensitivityGamma = 0.0; // Tunes multipath exploration aggression
        double congestion_objective_penalty = 0.0;
        
        for (const auto& pair : aggregate_link_flows) {
            double actual_flow = pair.second;
            congestion_objective_penalty += 0.5 * kMultipathSensitivityGamma * config.gradient_epsilon * actual_flow * actual_flow;
        }
        
        double max_commodity_delay = 0.0;
        if (!commodity_delays.empty()) {
            max_commodity_delay = *std::max_element(commodity_delays.begin(), commodity_delays.end());
        }

        double sum_exponentials = 0.0;
        for (double t : commodity_delays) {
            sum_exponentials += std::exp(config.penalty_multiplier * (t - max_commodity_delay));
        }
        if (sum_exponentials < 1e-9) sum_exponentials = 1e-9;

        double current_objective_value = (config.step_size_alpha / config.penalty_multiplier) * (config.penalty_multiplier * max_commodity_delay + std::log(sum_exponentials)) + 
                                         total_energy_penalty + 
                                         congestion_objective_penalty;

        double previous_diff_gap = (current_iteration > 0) ? std::abs(previous_objective_value - current_objective_value) : 1.0;
        previous_objective_value = current_objective_value;

        // =========================================================
        // Step 2: Descent Direction Search (Shortest Path Subproblem)
        // =========================================================
        std::vector<std::map<Link, double>> subproblem_routing_matrix(commodity_demands.size());
        std::vector<double> softmax_weights(commodity_demands.size());
        std::vector<std::map<Link, double>> commodity_link_weights(commodity_demands.size());

        for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
            softmax_weights[k] = std::exp(config.penalty_multiplier * (commodity_delays[k] - max_commodity_delay)) / sum_exponentials;
        }

        auto get_link_weight = [&](Link l, double beta, double traffic_vol) -> double {
            double real_rate = rate_capacities.count(l) ? rate_capacities.at(l) : 1e-9;
            double safe_rate = std::max(real_rate, kVirtualCapacityFallback);
            double allocated_power = (power_allocations.count(l)) ? power_allocations.at(l) : 0.0;
            double exploration_rate = std::max(safe_rate, 0.1); 

            // Base mathematical gradient 
            double base_weight = config.step_size_alpha * (beta + config.gradient_epsilon) * (traffic_vol / exploration_rate) + 
                                 (1.0 - config.step_size_alpha) * traffic_vol * (allocated_power / exploration_rate);
                                 
            // Dynamic congestion penalty injection (Traffic-aware)
            double current_link_flow = aggregate_link_flows.count(l) ? aggregate_link_flows.at(l) : 0.0;
            double congestion_penalty = kMultipathSensitivityGamma * config.gradient_epsilon * current_link_flow * traffic_vol;

            return base_weight + congestion_penalty;
        };

        for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
            double traffic_volume = std::get<2>(commodity_demands[k]);
            std::size_t source_node = std::get<0>(commodity_demands[k]);
            std::size_t target_node = std::get<1>(commodity_demands[k]);

            std::map<Link, double>& current_weights = commodity_link_weights[k]; 
            
            for (const auto& edge : network_edges) {
                int u = static_cast<int>(std::get<0>(edge));
                int v = static_cast<int>(std::get<1>(edge));
                Link current_link = { u, v };
                current_weights[current_link] = get_link_weight(current_link, softmax_weights[k], traffic_volume);
            }

            std::vector<Link> shortest_path = dijkstra_weighted(graph, num_nodes, static_cast<int>(source_node), static_cast<int>(target_node), current_weights);
            
            if (!shortest_path.empty()) {
                for (const auto& l : shortest_path) {
                    subproblem_routing_matrix[k][l] = 1.0;
                }
            }
        }

        // =========================================================
        // Step 3: Curvature Calculation & Energy Prep
        // =========================================================
        double numerator_gap = 0.0;
        double sum_beta_u_sq = 0.0;
        double sum_beta_u = 0.0;
        bool any_subproblem_valid = false;

        std::vector<double> subproblem_delays(commodity_demands.size(), 0.0);
        double subproblem_energy_term = 0.0; 

        for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
            if (subproblem_routing_matrix[k].empty()) {
                subproblem_delays[k] = 1e15;
                continue;
            }
            any_subproblem_valid = true;
            double traffic_volume = std::get<2>(commodity_demands[k]);

            // Compute physical properties of the new subproblem path (Y)
            for (const auto& pair : subproblem_routing_matrix[k]) {
                Link current_link = pair.first;
                double real_rate = rate_capacities.count(current_link) ? rate_capacities.at(current_link) : 1e-9;
                double safe_rate = std::max(real_rate, kVirtualCapacityFallback);
                double exploration_rate = std::max(safe_rate, 0.1);
                double allocated_power = (power_allocations.count(current_link)) ? power_allocations.at(current_link) : 0.0;

                subproblem_delays[k] += (traffic_volume / exploration_rate);
                subproblem_energy_term += 1.0 * (1.0 - config.step_size_alpha) * traffic_volume * (allocated_power / exploration_rate); 
            }

            // Compute LSE curvature-related terms
            double delay_difference_u = subproblem_delays[k] - commodity_delays[k];
            sum_beta_u_sq += softmax_weights[k] * (delay_difference_u * delay_difference_u);
            sum_beta_u += softmax_weights[k] * delay_difference_u;

            // [Robust Lookup]: Defend against "Phantom Edges" potentially injected by KSP initialization
            double current_state_cost = 0.0;
            double subproblem_cost = 0.0;
            double current_traffic_vol = std::get<2>(commodity_demands[k]); 

            for (auto& pair : flow_routing_matrix[k]) {
                auto iterator = commodity_link_weights[k].find(pair.first);
                if (iterator != commodity_link_weights[k].end()) {
                    current_state_cost += pair.second * iterator->second;
                } else {
                    // [Audit Alert]: Edge detected in routing matrix that is absent from edge_list
                    std::cerr << "[Warning] Phantom Edge Detected (Absent from master edge_list): Node "
                              << pair.first.first << " -> Node " << pair.first.second
                              << " (Routing Fraction: " << pair.second << ")\n";
                    current_state_cost += pair.second * get_link_weight(pair.first, softmax_weights[k], current_traffic_vol);
                }
            }

            for (auto& pair : subproblem_routing_matrix[k]) {
                auto iterator = commodity_link_weights[k].find(pair.first);
                double edge_weight = (iterator != commodity_link_weights[k].end()) 
                                     ? iterator->second 
                                     : get_link_weight(pair.first, softmax_weights[k], current_traffic_vol);
                subproblem_cost += 1.0 * edge_weight; // Subproblem flow fraction is always 1.0 (pure SP)
            }

            numerator_gap += (current_state_cost - subproblem_cost);
        }
        
        if (numerator_gap < 0.0) {
            numerator_gap = 0.0; // Filter floating-point jitter
        }

        if (!any_subproblem_valid) {
            std::cerr << "[Fatal Error] No valid descent directions found across all commodities.\n";
            break;
        }

        // --- Post-Calculation Updates ---
        if (numerator_gap < minimum_duality_gap) {
            minimum_duality_gap = numerator_gap;
            best_objective_value = previous_objective_value;
            best_flow_routing_matrix = flow_routing_matrix;
            best_iteration_index = current_iteration; 
        }
        
        // Convergence Check
        if (numerator_gap < config.convergence_tolerance) {
            std::cout << ">>> Algorithm convergence achieved (Duality Gap < Tolerance).\n";
            termination_reason = "Satisfying (Gap < Tolerance)"; 
            break;
        }

        double delay_variance = sum_beta_u_sq - (sum_beta_u * sum_beta_u);
        if (delay_variance < 0.0) delay_variance = 0.0;
        
        // Curvature contribution strictly derived from the non-linear LSE component
        double lse_curvature = config.step_size_alpha * config.penalty_multiplier * delay_variance; 

        // =========================================================
        // Step 4: Step Size Calculation (Exact Hessian Formulation)
        // =========================================================

        // 1. Exact second-order derivative (Hessian) for the quadratic penalty term
        double exact_penalty_curvature = 0.0;
        std::map<Link, double> flow_volume_delta; 

        for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
            if (subproblem_routing_matrix[k].empty()) continue;
            double traffic_volume = std::get<2>(commodity_demands[k]);
            for (const auto& pair : subproblem_routing_matrix[k]) {
                flow_volume_delta[pair.first] += pair.second * traffic_volume; 
            }
        }
        
        for (const auto& pair : aggregate_link_flows) {
            flow_volume_delta[pair.first] -= pair.second;
        }

        // Aggregate curvature. Scaling factor MUST match the gradient injection: gamma * epsilon
        for (const auto& pair : flow_volume_delta) {
            double link_flow_diff = pair.second;
            exact_penalty_curvature += kMultipathSensitivityGamma * config.gradient_epsilon * (link_flow_diff * link_flow_diff);
        }

        // 2. Fusion: Total Curvature = LSE Curvature + Exact Penalty Curvature
        double total_system_curvature = lse_curvature + exact_penalty_curvature;
        double optimal_step_size = 0.0;

        // Exact Newton-based Step Size Optimization
        if (total_system_curvature > 1e-12) {
            double newton_step = numerator_gap / total_system_curvature;
            // Retain trust-region bound to prevent non-convex oscillation during early severe congestion
            double max_allowed_step = 0.6 / std::sqrt(current_iteration + 1.0);
            optimal_step_size = std::min(max_allowed_step, std::max(0.0, newton_step));
        } else {
            // Degenerate curvature fallback to standard asymptotic decay
            optimal_step_size = std::min(0.25, 2.0 / (current_iteration + 2.0));
        }

        // Enforce minimum propulsion to prevent premature algorithmic stalling
        if (optimal_step_size < 1e-5 && numerator_gap > 1e-3) {
            optimal_step_size = 1e-4;
        }

        // =========================================================
        // Step 5: Decision Variable Update (Convex Combination)
        // =========================================================
        for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
            if (subproblem_routing_matrix[k].empty()) continue;

            // Scale current state: x_new = (1 - lambda) * x_old
            for (auto iterator = flow_routing_matrix[k].begin(); iterator != flow_routing_matrix[k].end(); ) {
                iterator->second *= (1.0 - optimal_step_size);
                if (iterator->second < 1e-9) {
                    iterator = flow_routing_matrix[k].erase(iterator);
                } else {
                    ++iterator;
                }
            }
            
            // Add subproblem direction: x_new += lambda * y
            for (const auto& pair : subproblem_routing_matrix[k]) {
                flow_routing_matrix[k][pair.first] += optimal_step_size * pair.second; 
            }
        }

        current_iteration++;
    } 

    // =========================================================
    // Convergence Diagnostics & State Restoration
    // =========================================================

    std::cout << "\n========================================================\n"
              << "             Frank-Wolfe Optimization Summary           \n"
              << "========================================================\n"
              << "Termination Reason : " << termination_reason << "\n"
              << "Iterations         : " << (current_iteration - 1) << " / " << config.max_iterations << "\n";

    double relative_gap = (std::abs(best_objective_value) > 1e-9) ? (minimum_duality_gap / std::abs(best_objective_value)) : 1.0;

    std::cout << "Optimal Iterate    : Iter " << best_iteration_index
              << " (Abs Gap = " << std::defaultfloat << minimum_duality_gap
              << ", Rel Gap = " << std::fixed << std::setprecision(3) << relative_gap * 100.0 << "%)\n"
              << "Optimal Objective  : " << std::defaultfloat << best_objective_value << "\n"
              << "--------------------------------------------------------\n";

    if ((current_iteration - 1) - best_iteration_index > 50) {
        std::cout << "[Note] Optimal solution acquired early at Iteration " << best_iteration_index << ".\n"
                  << "       Subsequent " << ((current_iteration - 1) - best_iteration_index) 
                  << " iterations yielded no strict descent.\n";
    }
    std::cout << "========================================================\n\n";

    // =========================================================
    // Core Upgrade: Max-Bottleneck Top-K Flow Decomposition
    // Cleanses macro-routing cycles and extracts pure DAG multipaths
    // =========================================================
    std::cout << ">>> Executing Flow Decomposition (Top-K Max-Bottleneck) <<<\n";

    struct ExtractedPath {
        std::vector<Link> edges;
        double volume;
    };

    for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
        int source_node = static_cast<int>(std::get<0>(commodity_demands[k]));
        int target_node = static_cast<int>(std::get<1>(commodity_demands[k]));

        std::map<Link, double>& raw_optimal_flow = best_flow_routing_matrix[k];

        // 1. Physical Ping-Pong Cycle Cancellation
        for (auto& pair : raw_optimal_flow) {
            int u = pair.first.first;
            int v = pair.first.second;

            if (u < v && raw_optimal_flow.count({ v, u })) {
                double f_forward = pair.second;
                double f_reverse = raw_optimal_flow[{v, u}];

                if (f_forward > f_reverse) {
                    pair.second = f_forward - f_reverse;
                    raw_optimal_flow[{v, u}] = 0.0;
                } else {
                    raw_optimal_flow[{v, u}] = f_reverse - f_forward;
                    pair.second = 0.0;
                }
            }
        }

        std::vector<ExtractedPath> all_extracted_paths;
        double total_extracted_volume = 0.0;

        // 2. Iterative Max-Bottleneck Path Extraction
        while (true) {
            std::priority_queue<std::pair<double, int>> bottleneck_pq;
            std::map<int, double> bottleneck_capacities;
            std::map<int, int> traversal_parents;

            for (std::size_t i = 0; i < num_nodes; ++i) {
                bottleneck_capacities[static_cast<int>(i)] = 0.0;
            }

            bottleneck_capacities[source_node] = 1e9; 
            bottleneck_pq.push({ 1e9, source_node });

            bool path_found = false;
            
            while (!bottleneck_pq.empty()) {
                auto [current_flow_limit, u] = bottleneck_pq.top();
                bottleneck_pq.pop();

                if (current_flow_limit < bottleneck_capacities[u]) continue;

                if (u == target_node) {
                    path_found = true;
                    break;
                }

                for (const auto& edge_pair : raw_optimal_flow) {
                    if (edge_pair.first.first == u && edge_pair.second > 1e-5) {
                        int v = edge_pair.first.second;
                        double edge_residual_capacity = edge_pair.second;

                        double path_bottleneck = std::min(current_flow_limit, edge_residual_capacity);

                        if (path_bottleneck > bottleneck_capacities[v]) {
                            bottleneck_capacities[v] = path_bottleneck;
                            traversal_parents[v] = u;
                            bottleneck_pq.push({ path_bottleneck, v });
                        }
                    }
                }
            }

            if (!path_found || bottleneck_capacities[target_node] < 1e-5) {
                break;
            }

            int current_vertex = target_node;
            std::vector<Link> extracted_route;
            double extracted_bottleneck_flow = bottleneck_capacities[target_node];

            while (current_vertex != source_node) {
                int previous_vertex = traversal_parents[current_vertex];
                Link current_link = { previous_vertex, current_vertex };
                extracted_route.push_back(current_link);
                current_vertex = previous_vertex;
            }

            all_extracted_paths.push_back({ extracted_route, extracted_bottleneck_flow });
            total_extracted_volume += extracted_bottleneck_flow;

            // Deduct extracted flow from the residual network
            for (const auto& lk : extracted_route) {
                raw_optimal_flow[lk] -= extracted_bottleneck_flow;
            }
        }

        // 3. Proportional Sorting and Top-K Truncation
        std::map<Link, double> sanitized_flow_matrix;

        if (!all_extracted_paths.empty()) {
            std::sort(all_extracted_paths.begin(), all_extracted_paths.end(),
                [](const ExtractedPath& a, const ExtractedPath& b) {
                    return a.volume > b.volume;
                });

            double retained_volume = 0.0;
            int retained_path_count = 0;
            const int kMaxRetainedPaths = 5;
            const double kTruncationThresholdRatio = 0.01; // Retain paths holding > 1% flow

            for (std::size_t i = 0; i < all_extracted_paths.size(); ++i) {
                const auto& path = all_extracted_paths[i];
                double proportional_ratio = path.volume / (total_extracted_volume + 1e-15);

                if ((proportional_ratio > kTruncationThresholdRatio && retained_path_count < kMaxRetainedPaths) || i == 0) {
                    retained_volume += path.volume;
                    retained_path_count++;
                    for (const auto& lk : path.edges) {
                        sanitized_flow_matrix[lk] += path.volume;
                    }
                } else {
                    break;
                }
            }

            // 4. Multipath Flow Normalization (Scale up to exactly 100%)
            if (retained_volume > 0.0) {
                double normalization_scale = 1.0 / retained_volume;
                for (auto& pair : sanitized_flow_matrix) {
                    pair.second *= normalization_scale;
                }
            }
        }

        best_flow_routing_matrix[k] = sanitized_flow_matrix;
    }

    // Restore the mathematically sanitized optimal routing matrix
    flow_routing_matrix = best_flow_routing_matrix;

    // Accurately reconstruct the active edge set from the cleansed telemetry
    active_edges.clear();
    for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
        for (const auto& pair : flow_routing_matrix[k]) {
            if (pair.second > 1e-6) {
                active_edges.insert(pair.first);
            }
        }
    }

    std::cout << "Active Network Edges (Post-Cleansing): " << active_edges.size() << "\n";
}
