/**
 * @brief Encapsulates the comprehensive execution results of the optimization algorithm.
 * 
 * @note This struct maps directly to external interfaces (e.g., Pybind11). 
 * Field names are preserved to ensure zero logic/binding alteration.
 */
struct AlgoResult {
    std::string name;
    int iter;
    double best_F;
    int active_links;
    double max_delay;
    double max_sum_delay;
    double diff_F;
    double total_energy;
    int multipath_count;
    long long time_ms;
    
    std::vector<std::map<Link, double>> final_flow_routing_matrix;
    
    // Convergence trajectory history
    std::vector<double> history_F;
    std::vector<double> history_T;
    std::vector<double> history_E;
    std::vector<double> history_T_sum;
    std::vector<double> history_diff;
    std::vector<double> flow_max_delays;

    // Advanced comparative metrics
    double energy_efficiency;    
    double jain_fairness_index;  
    double avg_link_delay;       
    
    // Traffic demand tuples (source, destination, demand_volume)
    std::vector<std::tuple<size_t, size_t, double>> pd_data;
    
    // Microscopic resource allocation profiling
    std::vector<double> final_p_opt;  // Optimized power allocation per link
    std::vector<double> final_r_opt;  // Optimized capacity/rate per link
    std::vector<double> final_l_opt;  // Lagrangian multipliers per link
};

