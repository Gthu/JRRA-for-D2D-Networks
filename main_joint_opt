/**
 * @brief Structure to store comprehensive results for a specific algorithm iteration.
 * 
 * @note Contains both routing trajectories and advanced performance metrics (EE, JFI)
 * suitable for high-tier journal reporting.
 */
struct AlgorithmResult {
    std::string name;
    int iter;
    double best_objective;
    int active_links;
    double max_delay;
    double max_sum_delay;
    double objective_difference;
    double total_energy;
    int multipath_count;
    long long time_ms;
    
    std::vector<std::map<Link, double>> final_flow_fractions;
    
    // Convergence Trajectories
    std::vector<double> history_objective;
    std::vector<double> history_delay;
    std::vector<double> history_energy;
    std::vector<double> history_sum_delay;
    std::vector<double> history_diff;
    
    // Advanced Benchmark Metrics
    double energy_efficiency;    
    double jain_fairness_index;  
    double avg_link_delay;       
    
    std::vector<std::tuple<size_t, size_t, double>> traffic_demands;
};

/**
 * @brief Extracts the unique set of edges from a given collection of graph paths.
 * 
 * @param path_set Collection of generated paths (e.g., from K-Shortest Paths).
 * @return std::set<Link> Set of unique active edges forming the subgraph.
 */
std::set<Link> extract_subgraph_edges_main(const std::vector<GraphPath>& path_set) {
    std::set<Link> subgraph_edges;
    for (const auto& path : path_set) {
        if (path.size() < 2) continue;
        for (size_t i = 0; i < path.size() - 1; ++i) {
            int u = static_cast<int>(path[i]);
            int v = static_cast<int>(path[i + 1]);
            subgraph_edges.insert({ u, v });
        }
    }
    return subgraph_edges;
}

/**
 * @brief Validates end-to-end physical layer connectivity for all commodities.
 * 
 * @param num_nodes Total number of nodes in the graph.
 * @param link_rates Current physical capacity map of all edges.
 * @param traffic_demands Tuple containing source, destination, and demand volume.
 * @return true if all source-destination pairs are connected, false otherwise.
 * 
 * @note Time Complexity: O(K * (V + E)), where K is the number of commodities.
 * Executes a Breadth-First Search (BFS) to guarantee routing feasibility before optimization.
 */
bool check_physical_connectivity(int num_nodes, 
                                 const LinkMap& link_rates, 
                                 const std::vector<std::tuple<size_t, size_t, double>>& traffic_demands) {
    std::vector<std::vector<int>> adjacency_list(num_nodes);
    for (const auto& pair : link_rates) {
        if (pair.second > 1e-6) adjacency_list[pair.first.first].push_back(pair.first.second);
    }
    
    bool all_connected = true;
    std::cout << "\n[Connectivity Check] Validating physical layer connectivity...\n";
    
    for (size_t k = 0; k < traffic_demands.size(); ++k) {
        int src = static_cast<int>(std::get<0>(traffic_demands[k]));
        int des = static_cast<int>(std::get<1>(traffic_demands[k]));
        
        std::vector<bool> visited(num_nodes, false);
        std::queue<int> node_queue;
        
        node_queue.push(src); 
        visited[src] = true;
        bool is_connected = false;
        
        while (!node_queue.empty()) {
            int u = node_queue.front(); 
            node_queue.pop();
            
            if (u == des) { 
                is_connected = true; 
                break; 
            }
            for (int v : adjacency_list[u]) {
                if (!visited[v]) { 
                    visited[v] = true; 
                    node_queue.push(v); 
                }
            }
        }
        
        if (!is_connected) {
            std::cout << "  -> [WARNING] Commodity " << k << " is DISCONNECTED!\n";
            all_connected = false;
        }
    }
    return all_connected;
}

/**
 * @brief Core execution engine for a single Block Coordinate Descent (BCD) experiment.
 * 
 * @param file_path Path to the graph topology CSV.
 * @param demand_file_path Path to the traffic demands CSV.
 * @param stress_factor Multiplier to scale baseline network traffic.
 * @param user_alpha Trade-off parameter between delay and energy consumption.
 * @return std::vector<AlgorithmResult> Collection of benchmarking results for all tested algorithms.
 * 
 * @note Implements an Alternating Optimization framework. The routing phase relies on 
 * Frank-Wolfe (FW) or Interior Point Method (IPM) to distribute traffic flows (O(K * E log V)), 
 * and the resource phase solves the Lagrangian dual via subgradient descent.
 */
std::vector<AlgorithmResult> run_single_experiment(
    const std::string& file_path,
    const std::string& demand_file_path,
    double stress_factor,
    double user_alpha
) {
    auto start_main = std::chrono::system_clock::now();
    Col_gen graph_generator(file_path);
    
    size_t max_node_id = 0;
    for (const auto& edge : graph_generator.edge_list) {
        max_node_id = std::max(max_node_id, std::get<0>(edge));
        max_node_id = std::max(max_node_id, std::get<1>(edge));
    }
    size_t num_nodes = max_node_id + 1;
    Graph graph(num_nodes, graph_generator);

    std::vector<std::tuple<size_t, size_t, double>> traffic_demands = Get_demand(demand_file_path);
    int demand_num = static_cast<int>(traffic_demands.size());
    for (auto& demand : traffic_demands) {
        std::get<2>(demand) *= stress_factor;
    }

    // ==================================================================================
    // 1. Initial KSP Probing & Flow Cold Start
    // ==================================================================================
    std::vector<std::map<Link, double>> flow_routing_fractions(demand_num);
    std::vector<GraphPath> active_path_set;
    int num_shortest_paths = 10;
    int target_path_count = 3;

    int demand_idx = 0;
    for (const auto& demand : traffic_demands) {
        size_t src = std::get<0>(demand);
        size_t des = std::get<1>(demand);
        
        auto [primary_path, primary_path_length] = dijkstra(graph, src, des);
        if (primary_path_length != 0 || src == des) {
            auto candidate_paths = k_shortest_paths(target_path_count, primary_path, num_shortest_paths, graph_generator, graph, src);
            if (!candidate_paths.empty()) {
                double split_ratio = 1.0 / static_cast<double>(candidate_paths.size());
                for (const auto& path : candidate_paths) {
                    if (path.size() < 2) continue;
                    for (size_t i = 0; i < path.size() - 1; ++i) {
                        Link link = { static_cast<int>(path[i]), static_cast<int>(path[i + 1]) };
                        flow_routing_fractions[demand_idx][link] += split_ratio; 
                    }
                }
                active_path_set.insert(active_path_set.end(), candidate_paths.begin(), candidate_paths.end());
            }
        }
        demand_idx++;
    }

    // ==================================================================================
    // 2. Initial Resource Allocation
    // ==================================================================================
    std::set<Link> active_subgraph_edges = extract_subgraph_edges_main(active_path_set);
    double max_power_per_node = 0.2;   
    std::vector<double> node_power_limits(num_nodes, max_power_per_node);
    double total_bandwidth_spectrum = 20.0;  
    const double noise_power_density = -114.0;

    InitialAllocation res_alloc = initialize_resources(graph, active_subgraph_edges, node_power_limits, total_bandwidth_spectrum);
    std::set<Link>& active_edges = res_alloc.E_active;
    LinkMap& link_powers = res_alloc.p0;
    LinkMap& dual_multipliers = res_alloc.l0;

    LinkMap link_rates = calculate_rates(graph, num_nodes, active_edges, dual_multipliers, link_powers, noise_power_density, graph_generator.edge_list.size(), total_bandwidth_spectrum, node_power_limits);

    if (!check_physical_connectivity(num_nodes, link_rates, traffic_demands)) {
        std::cerr << ">>> [ERROR] Critical connectivity failure! Aborting run!\n";
        return {}; 
    }

    // ==================================================================================
    // 3. Alternating Optimization Macro-Loop Configuration
    // ==================================================================================
    const int MACRO_MAX_ITER = 10;
    const double PENALTY_WEIGHT = 1e6;

    FWConfig config_fw;
    config_fw.mu = 5.0;
    config_fw.alpha = user_alpha;
    config_fw.tolerance = 1e-4;
    config_fw.epsilon = 0.05; 
    config_fw.max_iter = 2e2;

    std::vector<std::map<Link, double>> init_flow_fractions = flow_routing_fractions;
    std::map<Link, double> init_link_rates = link_rates;
    std::map<Link, double> init_link_powers = link_powers;
    std::map<Link, double> init_dual_multipliers = dual_multipliers;

    std::vector<AlgorithmResult> summary_results;
    std::vector<std::string> test_algorithms = { "BCD-FW", "BCD-IPM", "SP-PDA", "KSP-PDA", "Static-Allocation", "Game-Greedy", "SCA-Baseline" };

    // ==================================================================================
    // 4. Algorithm Benchmarking Execution
    // ==================================================================================
    for (const auto& current_algo : test_algorithms) {
        std::cout << "\n\n================================================================================\n";
        std::cout << "  >>> Start: Evaluating [" << current_algo << "] Algorithm <<<\n";
        std::cout << "================================================================================\n";

        flow_routing_fractions = init_flow_fractions;
        link_rates = init_link_rates;
        link_powers = init_link_powers;
        dual_multipliers = init_dual_multipliers;
        std::vector<std::map<Link, double>> prev_flow_fractions = flow_routing_fractions;

        double best_objective = std::numeric_limits<double>::max();
        double current_objective_difference = std::numeric_limits<double>::max(); 
        double best_sum_delay = 0.0;
        double best_objective_diff = 0.0;
        int num_iter = 999;
        
        std::vector<double> cur_hist_objective, cur_hist_delay, cur_hist_energy, cur_hist_sum_delay, cur_hist_diff;
        
        double prev_objective = std::numeric_limits<double>::max();
        double global_best_objective = std::numeric_limits<double>::max();
        int outer_stall_count = 0;

        std::vector<std::map<Link, double>> best_flow_fractions;
        OptimizationResult best_dual_res;
        double best_max_delay = 0.0;
        double best_total_energy = 0.0;
        int best_active_links = 0;

        auto start_algo = std::chrono::system_clock::now();

        // ---------------------------------------------------------
        // Macro BCD Alternating Optimization
        // ---------------------------------------------------------
        for (int iter = 1; iter <= MACRO_MAX_ITER; ++iter) {
            std::cout << "\n\n================================================================================\n";
            std::cout << "\n--- " << current_algo << " | Macro Iteration " << iter << " ---\n";
            std::cout << "================================================================================\n";
            num_iter = iter;

            // --- [Phase A]: Routing Subproblem ---
            if (current_algo == "BCD-FW") {
                std::cout << "[Routing Phase] Running BCD-FW Algorithm...\n";
                std::map<Link, double> dynamic_edge_weights;
                for (const auto& edge : graph_generator.edge_list) {
                    Link lk = { static_cast<int>(std::get<0>(edge)), static_cast<int>(std::get<1>(edge)) };
                    if (link_rates.count(lk) && link_rates[lk] < 1e-6) dynamic_edge_weights[lk] = PENALTY_WEIGHT;
                }
                solve_frank_wolfe(graph, graph_generator.edge_list, num_nodes, active_edges, traffic_demands, link_rates, link_powers, flow_routing_fractions, config_fw, dynamic_edge_weights);
            }
            else if (current_algo == "BCD-IPM") {
                std::cout << "[Routing Phase] Running Primal-Dual BCD-IPM Algorithm...\n";
                IPMConfig config_ipm = { 200, 1e-4, 1e-3 };
                solve_ipm_routing(graph, graph_generator.edge_list, num_nodes, traffic_demands, link_rates, link_powers, flow_routing_fractions, config_ipm, user_alpha);
            }
            else if (current_algo == "KSP-PDA") {
                std::cout << "[Routing Phase] Loading Static KSP-PDA Routes (Evenly split)...\n";
                flow_routing_fractions = init_flow_fractions;
            }
            else if (current_algo == "Static-Allocation" || current_algo == "SP-PDA") {
                std::cout << "[Routing Phase] Running Static Allocation (100% on Single Shortest Path)...\n";
                for (size_t k = 0; k < traffic_demands.size(); ++k) {
                    flow_routing_fractions[k].clear();
                    size_t src = std::get<0>(traffic_demands[k]);
                    size_t des = std::get<1>(traffic_demands[k]);
                    auto [primary_path, primary_path_length] = dijkstra(graph, src, des);
                    if (primary_path_length != 0 || src == des) {
                        for (size_t i = 0; i < primary_path.size() - 1; ++i) {
                            flow_routing_fractions[k][{ static_cast<int>(primary_path[i]), static_cast<int>(primary_path[i + 1]) }] = 1.0;
                        }
                    }
                }
            }
            else if (current_algo == "Game-Greedy") {
                std::cout << "[Routing Phase] Game-Greedy does Joint Optimization. Bypassing decoupled routing...\n";
            }
            
            // --- [Phase B]: Resource Allocation Subproblem ---
            OptimizationResult dual_res;
            if (current_algo == "Static-Allocation") {
                std::cout << "[Resource Phase] Running Equal Resource Allocation (ERA)...\n";
                dual_res = run_static_equal_allocation(graph_generator.edge_list, traffic_demands, flow_routing_fractions, total_bandwidth_spectrum, max_power_per_node, noise_power_density);
            }
            else if (current_algo == "Game-Greedy") {
                std::cout << "[Resource Phase] Running Game-Greedy Joint Allocation...\n";
                dual_res = run_game_greedy_baseline(graph_generator.edge_list, num_nodes, node_power_limits, total_bandwidth_spectrum, traffic_demands, noise_power_density);
                flow_routing_fractions = dual_res.final_x_flow;
            }
            else if (current_algo == "SCA-Baseline") {
                std::cout << "[Resource Phase] Running SCA-Based Joint Allocation...\n";
                dual_res = run_sca_baseline(graph_generator.edge_list, num_nodes, node_power_limits, total_bandwidth_spectrum, traffic_demands, noise_power_density);
                flow_routing_fractions = dual_res.final_x_flow;
            }
            else {
                std::cout << "[Resource Phase] Running Lagrangian Dual Decomposition...\n";
                try {
                    dual_res = run_dual_decomposition_solver(graph_generator.edge_list, num_nodes, node_power_limits, total_bandwidth_spectrum, traffic_demands, flow_routing_fractions, noise_power_density, user_alpha, 1e-4);
                }
                catch (const std::exception & e) {
                    std::cerr << "!!! Error: " << e.what() << std::endl; break;
                }
            }

            // --- [Phase C]: State Update & Evaluation ---
            double momentum_beta = 0.8;
            double min_virtual_rate = 0.05;
            double min_physical_rate = 0.1; 
            int current_active_links = 0;

            for (size_t i = 0; i < graph_generator.edge_list.size(); ++i) {
                Link lk = { static_cast<int>(std::get<0>(graph_generator.edge_list[i])), static_cast<int>(std::get<1>(graph_generator.edge_list[i])) };
                double new_dual = dual_res.l_opt[i];
                double new_power = dual_res.p_opt[i];
                double new_rate = dual_res.r_opt[i];
                
                if (new_rate > 1e-6) current_active_links++;

                if (current_algo == "BCD-FW" || current_algo == "BCD-IPM") {
                    bool has_traffic = false;
                    for (size_t k = 0; k < traffic_demands.size(); ++k) {
                        if (flow_routing_fractions[k].count(lk) && flow_routing_fractions[k][lk] > 1e-4) { has_traffic = true; break; }
                    }
                    if (has_traffic && new_rate < min_physical_rate) {
                        new_rate = min_physical_rate;
                    }
                    if (new_rate > 1e-6) current_active_links++;

                    if (iter == 1) {
                        dual_multipliers[lk] = new_dual; 
                        link_powers[lk] = new_power; 
                        link_rates[lk] = std::max(new_rate, min_virtual_rate);
                    }
                    else {
                        dual_multipliers[lk] = momentum_beta * dual_multipliers[lk] + (1.0 - momentum_beta) * new_dual;
                        link_powers[lk] = momentum_beta * link_powers[lk] + (1.0 - momentum_beta) * new_power;
                        link_rates[lk] = std::max(momentum_beta * link_rates[lk] + (1.0 - momentum_beta) * new_rate, min_virtual_rate);
                    }
                }
            }

            double current_objective_val = user_alpha * (dual_res.max_sum_delay) + (1.0 - user_alpha) * (dual_res.total_energy);
            current_objective_difference = user_alpha * (dual_res.max_sum_delay) - user_alpha * (dual_res.max_delay);
            current_objective_difference = (current_objective_difference > 1e-6) ? current_objective_difference : 0.0;

            std::cout << " --> Max Delay: " << dual_res.max_delay << " s, Total Energy: " << dual_res.total_energy 
                      << " J | Objective: " << current_objective_val << " Gap: " << current_objective_difference << "\n";

            cur_hist_objective.push_back(current_objective_val);
            cur_hist_delay.push_back(dual_res.max_delay);
            cur_hist_sum_delay.push_back(dual_res.max_sum_delay); 
            cur_hist_diff.push_back(current_objective_difference);                  
            cur_hist_energy.push_back(dual_res.total_energy);

            if (iter == 1 || current_objective_val < best_objective) {
                best_objective = current_objective_val;
                best_flow_fractions = flow_routing_fractions;
                best_dual_res = dual_res;
                best_max_delay = dual_res.max_delay;
                best_total_energy = dual_res.total_energy;
                best_active_links = current_active_links;
                best_sum_delay = dual_res.max_sum_delay;
                best_objective_diff = current_objective_difference;
            }

            if (current_algo == "Static-Allocation" || current_algo == "KSP-PDA" || current_algo == "SP-PDA" || current_algo == "Game-Greedy" || current_algo == "SCA-Baseline") {
                std::cout << ">>> [" << current_algo << "] is a static/decoupled baseline. Exiting macro-loop early! <<<\n";
                break;
            }

            int slow_progress_count = 0;
            if (iter > 1) {
                if (current_objective_val < global_best_objective) { global_best_objective = current_objective_val; outer_stall_count = 0; }
                else { outer_stall_count++; }

                if (current_objective_val > prev_objective * 1.05) { std::cout << ">>> Objective degraded > 5%, Stop! <<<\n"; break; }
                if (outer_stall_count >= 3) { std::cout << ">>> No improvement within 3 iterations, Stop! <<<\n"; break; }
                
                double rel_imp = (prev_objective - current_objective_val) / (prev_objective + 1e-9);
                if (rel_imp > 0 && rel_imp < 1e-3) {
                    slow_progress_count++; 
                }
                else if (rel_imp >= 1e-3) {
                    slow_progress_count = 0; 
                }
                
                if (slow_progress_count >= 3) {
                    std::cout << ">>> Convergence is too slow (rel_imp < 1e-3 for 3 iters). Stopping! <<<\n";
                    break;
                }
            }
            else { global_best_objective = current_objective_val; }

            prev_objective = current_objective_val;
            prev_flow_fractions = flow_routing_fractions;
        }

        auto end_algo = std::chrono::system_clock::now();
        long long duration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(end_algo - start_algo).count();

        // Flow conservation healing for interior point methods
        if (current_algo == "BCD-IPM") {
            for (size_t k = 0; k < traffic_demands.size(); ++k) {
                size_t src = std::get<0>(traffic_demands[k]);
                std::map<int, double> out_sum;
                std::map<int, int> in_degree;
                for (const auto& pair : best_flow_fractions[k]) {
                    out_sum[pair.first.first] += pair.second;
                    in_degree[pair.first.second]++;
                }

                std::map<Link, double> healed_flow;
                std::map<int, double> perfect_node_flow;
                perfect_node_flow[(int)src] = 1.0;
                std::queue<int> node_queue;
                node_queue.push((int)src);

                while (!node_queue.empty()) {
                    int u = node_queue.front(); node_queue.pop();
                    double current_flow = perfect_node_flow[u];
                    if (out_sum[u] > 1e-9) {
                        for (const auto& pair : best_flow_fractions[k]) {
                            if (pair.first.first == u) {
                                int v = pair.first.second;
                                double flow_to_v = current_flow * (pair.second / out_sum[u]);
                                healed_flow[{u, v}] = flow_to_v;
                                perfect_node_flow[v] += flow_to_v;
                                in_degree[v]--;
                                if (in_degree[v] == 0) node_queue.push(v);
                            }
                        }
                    }
                }
                best_flow_fractions[k] = healed_flow;
            }
        }

        int multipath_count = 0;
        for (size_t k = 0; k < traffic_demands.size(); ++k) {
            size_t src = std::get<0>(traffic_demands[k]);
            int outgoing_edges = 0;
            for (const auto& pair : best_flow_fractions[k]) {
                if (pair.first.first == (int)src && pair.second > 0.01) outgoing_edges++;
            }
            if (outgoing_edges > 1) multipath_count++;
        }

        // =========================================================
        // Advanced Benchmark Metric Processing
        // =========================================================
        double total_demand_volume = 0.0;
        for (const auto& demand : traffic_demands) total_demand_volume += std::get<2>(demand);

        double energy_efficiency_val = (best_total_energy > 1e-9) ? (total_demand_volume / best_total_energy) : 0.0;

        std::map<Link, double> edge_traffic;
        std::map<Link, double> optimized_link_rates; 
        for (size_t i = 0; i < graph_generator.edge_list.size(); ++i) {
            Link lk = { static_cast<int>(std::get<0>(graph_generator.edge_list[i])), static_cast<int>(std::get<1>(graph_generator.edge_list[i])) };
            optimized_link_rates[lk] = best_dual_res.r_opt[i];
        }
        
        for (size_t k = 0; k < traffic_demands.size(); ++k) {
            double demand_volume = std::get<2>(traffic_demands[k]);
            for (const auto& pair : best_flow_fractions[k]) {
                if (pair.second > 1e-4) edge_traffic[pair.first] += pair.second * demand_volume;
            }
        }

        double cumulative_congestion = 0.0;
        int used_links = 0;
        for (const auto& pair : edge_traffic) {
            Link lk = pair.first;
            double link_bandwidth = optimized_link_rates[lk];
            if (link_bandwidth > 1e-6) {
                cumulative_congestion += (pair.second / link_bandwidth); 
                used_links++;
            }
        }
        double avg_congestion = (used_links > 0) ? (cumulative_congestion / used_links) : 0.0;

        const auto& delay_per_flow = best_dual_res.flow_max_delays;
        double sum_delays = 0.0;
        double sum_squared_delays = 0.0;
        size_t total_commodities = delay_per_flow.size(); 

        for (double flow_delay : delay_per_flow) {
            sum_delays += flow_delay;
            sum_squared_delays += flow_delay * flow_delay;
        }

        double jain_fairness_idx = (total_commodities > 0 && sum_squared_delays > 1e-12) ?
            ((sum_delays * sum_delays) / (static_cast<double>(total_commodities) * sum_squared_delays)) : 0.0;

        AlgorithmResult current_res;
        current_res.iter = num_iter;
        current_res.name = current_algo;
        current_res.best_objective = best_objective;
        current_res.active_links = best_active_links;
        current_res.max_delay = best_max_delay;
        current_res.total_energy = best_total_energy;
        current_res.multipath_count = multipath_count;
        current_res.time_ms = duration_ms;
        current_res.final_flow_fractions = best_flow_fractions;
        current_res.max_sum_delay = best_sum_delay;
        current_res.objective_difference = best_objective_diff;

        current_res.energy_efficiency = energy_efficiency_val;
        current_res.avg_link_delay = avg_congestion; 
        current_res.jain_fairness_index = jain_fairness_idx;

        current_res.history_objective = cur_hist_objective;
        current_res.history_delay = cur_hist_delay;
        current_res.history_energy = cur_hist_energy;
        current_res.traffic_demands = traffic_demands;
        current_res.history_sum_delay = cur_hist_sum_delay;
        current_res.history_diff = cur_hist_diff;

        summary_results.push_back(current_res);
    }

    // ==================================================================================
    // 5. Benchmark Reporting Module
    // ==================================================================================
    std::cout << "\n\n";
    std::cout << "================================================================================================\n";
    std::cout << "                               Algorithm Comparison                                             \n";
    std::cout << "================================================================================================\n";
    std::cout << std::left
        << std::setw(15) << "Algorithm"
        << "| " << std::setw(10) << "Obj (F)"
        << "| " << std::setw(15) << "Active Links"
        << "| " << std::setw(12) << "T_max (s)"
        << "| " << std::setw(15) << "E_total (J)"
        << "| " << std::setw(10) << "Multipath"
        << "| " << "Time (ms)" << "\n";
    std::cout << "------------------------------------------------------------------------------------------------\n";

    for (const auto& res : summary_results) {
        std::cout << std::left
            << std::setw(15) << res.name
            << "| " << std::setw(10) << std::fixed << std::setprecision(4) << res.best_objective
            << "| " << std::setw(15) << (std::to_string(res.active_links) + " / " + std::to_string(graph_generator.edge_list.size()))
            << "| " << std::setw(12) << res.max_delay
            << "| " << std::setw(15) << res.total_energy
            << "| " << std::setw(10) << res.multipath_count
            << "| " << res.time_ms << "\n";
    }
    std::cout << "================================================================================================\n";

    std::cout << "\n>>> Stress Factor = " << stress_factor << "x <<<\n";
    for (const auto& res : summary_results) {
        std::cout << "  -> Algorithm [" << std::left << std::setw(15) << res.name << "] : ";
        if (res.multipath_count > 0) {
            std::cout << "Commodities triggering multipath routing: " << res.multipath_count << " / " << traffic_demands.size() << "\n";
        }
        else {
            std::cout << "Commodities triggering multipath routing: 0\n";
        }
    }
    std::cout << "================================================================================\n\n";

    auto end_main = std::chrono::system_clock::now();
    std::cout << "\n[Main] Total execution time: " << std::chrono::duration_cast<std::chrono::milliseconds>(end_main - start_main).count() << " ms\n";

    return summary_results;
}

/**
 * @brief Main entry point executing batch testing and exporting CSV telemetry.
 */
int main() {
    std::string graph_file = R"(..\data\data_d2d\graph_N60_K15.csv)";
    std::string demand_file = R"(..\data\data_d2d\demand_N60_K15.csv)";

    std::ofstream outfile(R"(..\data\data_d2d\experiment_results.csv)");
    outfile << "Group,Alpha,Stress,Algorithm,Obj,T_max,E_total,F_gap,Active_Links,Multipath_Count,EE(Mbits/J),JFI,Avg_Congestion,Iteration,Time_ms\n";

    // --- Experiment Set 1: Network Stress Testing ---
    std::cout << "\n>>>>>>>>>> Starting Group 1: Stress Testing <<<<<<<<<<\n";
    std::vector<double> stress_factors = { 1.0, 3.0, 5.0, 7.0, 9.0, 11.0, 13.0, 15.0 }; 

    for (double stress : stress_factors) {
        auto results = run_single_experiment(graph_file, demand_file, stress, 0.5);
        for (const auto& res : results) {
            outfile << "Stress_Test,0.5," << stress << "," << res.name << ","
                << res.best_objective << "," << res.max_delay << "," << res.total_energy << "," << res.objective_difference << ","
                << res.active_links << "," << res.multipath_count << ","
                << res.energy_efficiency << "," << res.jain_fairness_index << "," << res.avg_link_delay << ","
                << res.iter << "," << res.time_ms << "\n"; 
        }
    }

    // --- Experiment Set 2: Pareto Frontier Trade-offs ---
    std::cout << "\n>>>>>>>>>> Starting Group 2: Pareto Trade-off <<<<<<<<<<\n";
    std::vector<double> alphas = { 0.1, 0.3, 0.5, 0.7, 0.9, 0.95, 0.99 }; 

    for (double alpha : alphas) {
        auto results = run_single_experiment(graph_file, demand_file, 5.0, alpha);
        for (const auto& res : results) {
            if (res.name == "BCD-FW" || res.name == "BCD-IPM") {
                outfile << "Pareto," << alpha << ",5.0," << res.name << ","
                    << res.best_objective << "," << res.max_delay << "," << res.total_energy << "," << res.objective_difference << ","
                    << res.active_links << "," << res.multipath_count << ","
                    << res.energy_efficiency << "," << res.jain_fairness_index << "," << res.avg_link_delay << ","
                    << res.iter << "," << res.time_ms << "\n"; 
            }
        }
    }
    outfile.close();

    // ==================================================================================
    // Export Convergence History 
    // ==================================================================================
    std::cout << "\n>>> Saving convergence history to convergence_log.csv...\n";
    std::ofstream conv_file(R"(..\data\data_d2d\convergence_log.csv)");
    conv_file << "Scenario,Algorithm,Iteration,Obj,T_max,E_total,F_gap\n";

    double conv_stress = 5.0;
    double conv_alpha = 0.5;
    auto conv_results = run_single_experiment(graph_file, demand_file, conv_stress, conv_alpha);

    for (const auto& res : conv_results) {
        if (res.name == "BCD-FW" || res.name == "BCD-IPM") {
            for (size_t i = 0; i < res.history_objective.size(); ++i) {
                conv_file << "Stress_" << conv_stress << "_Alpha_" << conv_alpha << ","
                    << res.name << "," << (i + 1) << "," 
                    << res.history_objective[i] << ","
                    << res.history_delay[i] << ","
                    << res.history_energy[i] << "\n";
                if (i < res.history_diff.size()) {
                    conv_file << res.history_diff[i] << ",";
                }
                else {
                    conv_file << "0,"; 
                }
            }
        }
    }

    conv_file.close();
    std::cout << ">>> Convergence history saved successfully!\n";
    std::cout << "\n [SUCCESS] All experiments completed! Data saved to 'experiment_results.csv'.\n";
    
    return 0;
}
