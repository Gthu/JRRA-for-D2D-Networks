/**
 * @brief Validates physical layer connectivity for all traffic demands using Breadth-First Search (BFS).
 * 
 * @param num_nodes Total number of vertices in the network graph.
 * @param capacity_map Map of active physical link capacities (edge -> capacity).
 * @param traffic_demands Vector of source-destination demand tuples.
 * @return true if all source-destination pairs are reachable, false otherwise.
 * 
 * @note Time Complexity: O(K * (V + E)) where K is the number of commodities, 
 * V is the number of nodes, and E is the number of active edges.
 */
bool check_physical_connectivity(int num_nodes, 
                                 const LinkMap& capacity_map, 
                                 const std::vector<std::tuple<size_t, size_t, double>>& traffic_demands) {
    std::vector<std::vector<int>> adjacency_list(num_nodes);
    
    for (const auto& pair : capacity_map) {
        if (pair.second > 1e-6) {
            adjacency_list[pair.first.first].push_back(pair.first.second);
        }
    }
    
    bool all_connected = true;
    std::cout << "\n[Connectivity Check] Validating physical layer connectivity...\n";
    
    for (size_t k = 0; k < traffic_demands.size(); ++k) {
        int src = static_cast<int>(std::get<0>(traffic_demands[k]));
        int des = static_cast<int>(std::get<1>(traffic_demands[k]));
        
        std::vector<bool> visited(num_nodes, false);
        std::queue<int> node_queue;
        
        node_queue.push(src); 
        visited[src] = true;
        bool is_connected = false;
        
        while (!node_queue.empty()) {
            int u = node_queue.front(); 
            node_queue.pop();
            
            if (u == des) { 
                is_connected = true; 
                break; 
            }
            for (int v : adjacency_list[u]) {
                if (!visited[v]) { 
                    visited[v] = true; 
                    node_queue.push(v); 
                }
            }
        }
        
        if (!is_connected) {
            std::cout << "  -> [WARNING] Commodity " << k << " is DISCONNECTED!\n";
            all_connected = false;
        }
    }
    return all_connected;
}

/**
 * @brief Executes a single network optimization experiment across multiple algorithms.
 * 
 * @param file_path Path to the network topology configuration file.
 * @param demand_file_path Path to the traffic demand matrix file.
 * @param stress_factor Multiplier applied to baseline traffic demands.
 * @param user_alpha Weighting parameter balancing delay and energy consumption.
 * @return std::vector<AlgoResult> Collection of optimization profiles for each tested algorithm.
 */
std::vector<AlgoResult> run_single_experiment(
    const std::string& file_path,
    const std::string& demand_file_path,
    double stress_factor,
    double user_alpha
) {
    auto start_main = system_clock::now();
    Col_gen col_gen_graph(file_path);
    size_t max_node_id = 0;
    
    for (const auto& edge : col_gen_graph.edge_list) {
        max_node_id = std::max(max_node_id, std::get<0>(edge));
        max_node_id = std::max(max_node_id, std::get<1>(edge));
    }
    size_t num_nodes = max_node_id + 1;
    Graph graph(num_nodes, col_gen_graph);

    std::vector<std::tuple<size_t, size_t, double>> traffic_demands = Get_demand(demand_file_path);
    int demand_num = traffic_demands.size();
    for (auto& demand : traffic_demands) {
        std::get<2>(demand) *= stress_factor;
    }

    // ==================================================================================
    // 1. Engine Initialization Phase
    // ==================================================================================
    double max_power_per_node = 0.2;
    std::vector<double> node_power_limits(num_nodes, max_power_per_node);
    double total_bandwidth_mhz = 100.0;  
    const double noise_density_dbm = -114.0;

    InitializationResult init_res;
    InitializationResult probe_res = initialize_with_ksp_warm(
        graph, col_gen_graph, traffic_demands, num_nodes, max_power_per_node,
        0.5, total_bandwidth_mhz, noise_density_dbm); 

    auto [probe_T_max, probe_T_sum, probe_E_total, probe_delays] = evaluate_network_state(
        traffic_demands, probe_res.flow_routing_matrix, probe_res.initial_rate_capacity, probe_res.initial_power, probe_res.initial_bandwidth, total_bandwidth_mhz, num_nodes
    );

    // Normalization Anchors (Zero-Division Protection)
    const double ANCHOR_T = std::max(probe_T_max, 1e-5);
    const double ANCHOR_E = std::max(probe_E_total, 1e-5);
    
    // Calculate effective alpha for inner algorithms using mathematical substitution
    double weight_T = user_alpha / ANCHOR_T;
    double weight_E = (1.0 - user_alpha) / ANCHOR_E;
    double effective_alpha = weight_T / (weight_T + weight_E);

    std::string init_strategy = "KSP_PDA"; 
    std::cout << "\n================================================================================\n";
    std::cout << ">>> Initializing Network with Strategy: " << init_strategy << "\n";
    std::cout << "================================================================================\n";
    
    if (init_strategy == "KSP_PDA") {
        init_res = initialize_with_ksp_warm(graph, col_gen_graph, traffic_demands, num_nodes, max_power_per_node, effective_alpha, total_bandwidth_mhz, noise_density_dbm);
    } else {  
        init_res = initialize_with_ggb_warm_start(graph, col_gen_graph, traffic_demands, num_nodes, max_power_per_node, total_bandwidth_mhz, noise_density_dbm);
    }

    // Unpack initialization state to preserve downstream pointer/loop compatibility
    std::vector<std::map<Link, double>> flow_routing_matrix = init_res.flow_routing_matrix;
    std::vector<std::map<Link, double>> init_flow_routing_matrix = init_res.flow_routing_matrix; 
    std::set<Link> E_active = init_res.active_edges;
    LinkMap p0 = init_res.initial_power;
    LinkMap l0 = init_res.initial_bandwidth;
    LinkMap r0 = init_res.initial_rate_capacity;

    // ==================================================================================
    // 2. Connectivity Validation
    // ==================================================================================
    if (!check_physical_connectivity(num_nodes, r0, traffic_demands)) {
        std::cerr << ">>> [ERROR] Critical connectivity failure! Aborting run!\n";
        return {};
    }

    // ==================================================================================
    // 3. Iteration-0 Convergence Safe Box
    // ==================================================================================
    double best_objective_value = std::numeric_limits<double>::max();
    std::vector<std::map<Link, double>> best_flow_routing_matrix = flow_routing_matrix;
    OptimizationResult best_dual_res;
    
    auto [init_T_max, init_T_sum, init_E_total, init_flow_delays] = evaluate_network_state(
        traffic_demands, flow_routing_matrix, r0, p0, l0, total_bandwidth_mhz, num_nodes);
    
    double initial_normalized_objective = user_alpha * (init_T_max / ANCHOR_T) + (1.0 - user_alpha) * (init_E_total / ANCHOR_E);
    
    // Pre-allocate Generation-0 bounds to prevent BCD fallback corruption
    best_dual_res.optimal_bandwidths.resize(col_gen_graph.edge_list.size(), 0.0);
    best_dual_res.optimal_powers.resize(col_gen_graph.edge_list.size(), 0.0);
    best_dual_res.optimal_rates.resize(col_gen_graph.edge_list.size(), 0.0);

    for (size_t i = 0; i < col_gen_graph.edge_list.size(); ++i) {
        Link lk = { static_cast<int>(std::get<0>(col_gen_graph.edge_list[i])), static_cast<int>(std::get<1>(col_gen_graph.edge_list[i])) };
        best_dual_res.optimal_bandwidths[i] = l0.count(lk) ? l0.at(lk) : 0.0;
        best_dual_res.optimal_powers[i] = p0.count(lk) ? p0.at(lk) : 0.0;
        best_dual_res.optimal_rates[i] = r0.count(lk) ? r0.at(lk) : 0.0;
    }
    
    best_objective_value = initial_normalized_objective;
    double best_T_max = init_T_max;
    double best_E_total = init_E_total;
    int best_active_links = E_active.size();
    double best_T_sum = 0.0;  
    double best_diff_F = 0.0; 

    // Convergence telemetry trackers
    double diff_F = std::numeric_limits<double>::max();
    int current_iteration_idx = 999;
    int outer_stall_count = 0;
    double prev_objective_value = std::numeric_limits<double>::max();
    double global_best_objective = std::numeric_limits<double>::max();

    std::vector<double> current_hist_F, current_hist_T, current_hist_E;
    std::vector<double> current_hist_T_sum, current_hist_diff;
    const OptimizationResult BASELINE_dual_res = best_dual_res;

    // ==================================================================================
    // 4. Alternating Optimization Macro-Loop Setup
    // ==================================================================================
    const int MACRO_MAX_ITER = 10;
    const double PENALTY_WEIGHT = 1e6;

    // Immutable baselines to ensure clean algorithmic resets
    const std::vector<std::map<Link, double>> BASELINE_flow_routing_matrix = flow_routing_matrix;
    const std::set<Link> BASELINE_E_active = E_active;
    const std::map<Link, double> BASELINE_r0 = r0;
    const std::map<Link, double> BASELINE_p0 = p0;
    const std::map<Link, double> BASELINE_l0 = l0;
    const double BASELINE_F_initial = initial_normalized_objective;

    std::vector<AlgoResult> summary_results;
    std::vector<std::string> test_algorithms = { "BCD-FW", "BCD-IPM", "Static-Allocation" }; 
    
    std::cout << "\n>>>(user_alpha=" << user_alpha << ") <<<\n";

    // ==================================================================================
    // 5. Dual-Engine Benchmarking Execution
    // ==================================================================================
    for (const auto& current_algo : test_algorithms) {
        std::cout << "\n\n================================================================================\n";
        std::cout << "  >>> Start: Evaluating [" << current_algo << "] Algorithm <<<\n";
        std::cout << "================================================================================\n";
        
        // --- 0. Hard Reset: Physical & Network State ---
        flow_routing_matrix = BASELINE_flow_routing_matrix;
        E_active = BASELINE_E_active;
        r0 = BASELINE_r0;
        p0 = BASELINE_p0;
        l0 = BASELINE_l0;

        // --- 1. Hard Reset: Convergence Safe Box ---
        best_objective_value = BASELINE_F_initial;
        best_flow_routing_matrix = BASELINE_flow_routing_matrix;
        best_dual_res = BASELINE_dual_res;

        best_T_max = init_T_max;             
        best_E_total = init_E_total;         
        best_active_links = E_active.size(); 
        best_T_sum = 0.0;
        best_diff_F = 0.0;

        // --- 2. Hard Reset: Telemetry & Step Counters ---
        global_best_objective = std::numeric_limits<double>::max();
        outer_stall_count = 0;
        int slow_progress_count = 0;         

        current_hist_F.clear();
        current_hist_T.clear();
        current_hist_E.clear();
        current_hist_T_sum.clear();
        current_hist_diff.clear();

        std::vector<std::map<Link, double>> prev_flow_routing_matrix = BASELINE_flow_routing_matrix;
        
        // Optimization Configurations
        FWConfig config_fw;
        config_fw.penalty_multiplier = 5.0;  
        config_fw.step_size_alpha = effective_alpha; 
        config_fw.convergence_tolerance = 1e-4;
        config_fw.gradient_epsilon = 0.05;
        config_fw.max_iterations = 100;
        
        IPMConfig config_ipm = { 200, 1e-4, 1e-3, config_fw.penalty_multiplier }; 
        
        auto start_algo = std::chrono::system_clock::now();
        
        // ---------------------------------------------------------
        // Macro BCD Alternating Optimization
        // ---------------------------------------------------------
        for (int iter = 1; iter <= MACRO_MAX_ITER; ++iter) {
            std::cout << "\n\n================================================================================\n";
            std::cout << "\n--- " << current_algo << " | Macro Iteration " << iter << " ---\n";
            std::cout << "================================================================================\n";
            current_iteration_idx = iter;
            
            // =========================================================
            // [Phase A]: Routing Phase
            // =========================================================
            if (current_algo == "BCD-FW") {
                std::cout << "[Routing Phase] Running BCD-FW Algorithm...\n";
                std::map<Link, double> dynamic_edge_weights;
                solve_frank_wolfe(graph, col_gen_graph.edge_list, num_nodes, E_active, traffic_demands, r0, p0, flow_routing_matrix, config_fw, dynamic_edge_weights);
                config_fw.penalty_multiplier *= 1.1; // Progressively harden LSE smoothing
            }
            else if (current_algo == "BCD-IPM") {
                std::cout << "[Routing Phase] Running Primal-Dual BCD-IPM Algorithm...\n";
                solve_ipm_routing(graph, col_gen_graph.edge_list, num_nodes, traffic_demands, r0, p0, flow_routing_matrix, config_ipm, effective_alpha); 
                config_ipm.lse_smoothing_parameter *= 1.1;
            }
            else if (current_algo == "KSP-PDA") {
                std::cout << "[Routing Phase] Loading Static KSP-PDA Routes (Evenly split)...\n";
                flow_routing_matrix.clear();
                flow_routing_matrix.resize(traffic_demands.size());
                
                int k_max_paths = 10;
                int active_k_paths = 3;  
                int demand_idx = 0;
                
                for (const auto& demand : traffic_demands) {
                    size_t src = std::get<0>(demand);
                    size_t des = std::get<1>(demand);
                    
                    auto [p1, p1_length] = dijkstra(graph, src, des);
                    if (p1_length != 0 || src == des) {
                        auto multipath_routes = k_shortest_paths(active_k_paths, p1, k_max_paths, col_gen_graph, graph, src);
                        if (!multipath_routes.empty()) {
                            double split_ratio = 1.0 / static_cast<double>(multipath_routes.size());
                            for (const auto& path : multipath_routes) {
                                if (path.size() < 2) continue;
                                for (size_t i = 0; i < path.size() - 1; ++i) {
                                    Link link = { static_cast<int>(path[i]), static_cast<int>(path[i + 1]) };
                                    flow_routing_matrix[demand_idx][link] += split_ratio;
                                }
                            }
                        }
                    }
                    demand_idx++;
                }
            }
            else if (current_algo == "Static-Allocation" || current_algo == "SP-PDA") {
                std::cout << "[Routing Phase] Running Static Allocation (100% on Single Shortest Path)...\n";
                for (size_t k = 0; k < traffic_demands.size(); ++k) {
                    flow_routing_matrix[k].clear();
                    size_t src = std::get<0>(traffic_demands[k]);
                    size_t des = std::get<1>(traffic_demands[k]);
                    auto [p1, p1_length] = dijkstra(graph, src, des);
                    if (p1_length != 0 || src == des) {
                        for (size_t i = 0; i < p1.size() - 1; ++i) {
                            flow_routing_matrix[k][{ static_cast<int>(p1[i]), static_cast<int>(p1[i + 1]) }] = 1.0;
                        }
                    }
                }
            }
            else if (current_algo == "Game-Greedy") {
                std::cout << "[Routing Phase] Game-Greedy does Joint Optimization. Bypassing decoupled routing...\n";
            }
            
            // =========================================================
            // [Phase B]: Resource Allocation Phase
            // =========================================================
            OptimizationResult dual_res;
            
            if (current_algo == "Static-Allocation") {
                std::cout << "[Resource Phase] Running Equal Resource Allocation (ERA)...\n";
                dual_res = run_static_equal_allocation(col_gen_graph.edge_list, traffic_demands, flow_routing_matrix, total_bandwidth_mhz, max_power_per_node, noise_density_dbm);
            }
            else if (current_algo == "Game-Greedy") {
                std::cout << "[Resource Phase] Running Game-Greedy Joint Allocation...\n";
                dual_res = run_game_greedy_baseline(col_gen_graph.edge_list, num_nodes, node_power_limits, total_bandwidth_mhz, traffic_demands, noise_density_dbm);
                // Sync optimized routes generated internally back to global state
                flow_routing_matrix = dual_res.final_flow_routing;
            }
            /*else if (current_algo == "SCA-Baseline") {
                std::cout << "[Resource Phase] Running SCA-Based Joint Allocation...\n";
                dual_res = run_sca_baseline(col_gen_graph.edge_list, num_nodes, node_power_limits, total_bandwidth_mhz, traffic_demands, noise_density_dbm);
                flow_routing_matrix = dual_res.final_flow_routing;
            }*/
            else {
                std::cout << "[Resource Phase] Running Lagrangian Dual Decomposition...\n";
                bool x_is_clean = true;
                for (const auto& flow_map : flow_routing_matrix) {
                    for (const auto& pair : flow_map) {
                        if (std::isnan(pair.second) || std::isinf(pair.second)) {
                            std::cout << "  [Error] Corrupted flow x passed to LDD!\n";
                            x_is_clean = false;
                        }
                    }
                }
                
                if (current_algo == "KSP-PDA" || current_algo == "SP-PDA") {
                    // Track 1: Baseline Mode (PDA with single fail-safe)
                    try {
                        dual_res = run_dual_decomposition_solver(col_gen_graph.edge_list, num_nodes, node_power_limits, total_bandwidth_mhz, traffic_demands, flow_routing_matrix, noise_density_dbm, effective_alpha, 1e-2); 

                        // Fail-safe circuit breaker
                        if (dual_res.max_expected_sum_delay > 500.0) {
                            std::cout << "  >>> [WARNING] PDA diverged! Triggering Static Equal Allocation as Safe Net.\n";
                            dual_res = run_static_equal_allocation(col_gen_graph.edge_list, traffic_demands, flow_routing_matrix, total_bandwidth_mhz, max_power_per_node, noise_density_dbm);
                        }
                    }
                    catch (const std::exception & e) {
                        std::cerr << "!!! Error in PDA: " << e.what() << std::endl; 
                        break;
                    }
                }
                else {
                    // Track 2: Iterative Algorithm Protection Track
                    std::cout << "[Resource Phase] Running Protected Allocation...\n";

                    OptimizationResult res_ldd; 
                    
                    try {
                        res_ldd = run_dual_decomposition_solver(col_gen_graph.edge_list, num_nodes, node_power_limits, total_bandwidth_mhz, traffic_demands, flow_routing_matrix, noise_density_dbm, effective_alpha, 1e-2);
                        
                        if (res_ldd.max_expected_sum_delay > 500.0) {
                            std::cout << "  >>> [WARNING] PDA solver diverged (Delay > 500)! \n";
                            std::cout << "  >>> [Fallback] Triggering Static Equal Allocation as Safe Net.\n";
                            res_ldd = run_static_equal_allocation(col_gen_graph.edge_list, traffic_demands, flow_routing_matrix, total_bandwidth_mhz, max_power_per_node, noise_density_dbm);
                        }
                    }
                    catch (const std::exception& e) {
                        std::cerr << "  >>> [WARNING] PDA Exception: " << e.what() << std::endl;
                        std::cout << "  >>> [Fallback] Triggering Static Equal Allocation as Safe Net.\n";
                        res_ldd = run_static_equal_allocation(col_gen_graph.edge_list, traffic_demands, flow_routing_matrix, total_bandwidth_mhz, max_power_per_node, noise_density_dbm);
                    }
                    dual_res = res_ldd; 
                }
            }
            // ==================================================================================
            // [Phase C]: State Update (Momentum) & Surrogate Evaluation
            // ==================================================================================
            const double momentum_factor = 0.5;
            const double capacity_epsilon = 1e-9; 

            int current_active_links = 0;

            for (size_t i = 0; i < col_gen_graph.edge_list.size(); ++i) {
                Link current_link = { 
                    static_cast<int>(std::get<0>(col_gen_graph.edge_list[i])), 
                    static_cast<int>(std::get<1>(col_gen_graph.edge_list[i])) 
                };

                double new_lambda = dual_res.optimal_bandwidths[i];
                double new_power = dual_res.optimal_powers[i];
                double new_capacity = dual_res.optimal_rates[i];

                if (new_capacity > 1e-6) {
                    current_active_links++; 
                }

                if (current_algo == "BCD-FW" || current_algo == "BCD-IPM") {
                    if (current_iteration_idx == 1) {
                        l0[current_link] = new_lambda;
                        p0[current_link] = new_power;
                        r0[current_link] = std::max(new_capacity, capacity_epsilon); 
                    } else {
                        l0[current_link] = momentum_factor * l0[current_link] + (1.0 - momentum_factor) * new_lambda;
                        p0[current_link] = momentum_factor * p0[current_link] + (1.0 - momentum_factor) * new_power;
                        r0[current_link] = std::max(momentum_factor * r0[current_link] + (1.0 - momentum_factor) * new_capacity, capacity_epsilon);
                    }
                }
            }

            // ==================================================================================
            // Global Assessor Verification
            // Note: The algorithm's internal dual_res must be strictly verified by the 
            // global physical state evaluator to prevent surrogate objective pollution.
            // ==================================================================================
            std::map<Link, double> current_capacity_map;
            std::map<Link, double> current_power_map;
            std::map<Link, double> current_lambda_map;
            
            for (size_t i = 0; i < col_gen_graph.edge_list.size(); ++i) {
                Link current_link = { 
                    static_cast<int>(std::get<0>(col_gen_graph.edge_list[i])), 
                    static_cast<int>(std::get<1>(col_gen_graph.edge_list[i])) 
                };
                current_capacity_map[current_link] = dual_res.optimal_rates[i];
                current_power_map[current_link] = dual_res.optimal_powers[i];
                current_lambda_map[current_link] = dual_res.optimal_bandwidths[i];
            }

            auto [referee_max_delay, referee_max_sum_delay, referee_total_energy, flow_delays] = evaluate_network_state(
                traffic_demands, flow_routing_matrix, current_capacity_map, current_power_map, current_lambda_map, total_bandwidth_mhz, num_nodes
            );

            // Track A: Surrogate Score (Used for algorithmic convergence driving)
            double surrogate_objective = user_alpha * (referee_max_sum_delay / ANCHOR_T) +
                                         (1.0 - user_alpha) * (referee_total_energy / ANCHOR_E);

            // Track B: Strict Physical Score (Used for historical best validation)
            double physical_objective = user_alpha * (referee_max_delay / ANCHOR_T) +
                                        (1.0 - user_alpha) * (referee_total_energy / ANCHOR_E);
            
            double objective_gap = user_alpha * referee_max_sum_delay - user_alpha * referee_max_delay;
            objective_gap = (objective_gap > 1e-6) ? objective_gap : 0.0;

            // Record validated metrics into historical trajectories
            current_hist_F.push_back(physical_objective);
            current_hist_T.push_back(referee_max_delay);
            current_hist_T_sum.push_back(referee_max_sum_delay); 
            current_hist_diff.push_back(objective_gap);
            current_hist_E.push_back(referee_total_energy);

            // ==================================================================================
            // Convergence Safe Box Ratchet Mechanism
            // ==================================================================================
            bool is_single_shot_baseline = (current_algo == "Static-Allocation" ||
                                            current_algo == "KSP-PDA" ||
                                            current_algo == "SP-PDA" ||
                                            current_algo == "Game-Greedy" ||
                                            current_algo == "SCA-Baseline");

            if (is_single_shot_baseline || physical_objective < best_objective_value - 1e-5) {
                best_objective_value = physical_objective;
                best_flow_routing_matrix = flow_routing_matrix;
                best_dual_res = dual_res;
                best_T_max = referee_max_delay;
                best_E_total = referee_total_energy;
                best_active_links = current_active_links;
                best_T_sum = referee_max_sum_delay;
                best_diff_F = objective_gap;
            }

            if (is_single_shot_baseline) {
                std::cout << ">>> [" << current_algo << "] is a static/decoupled baseline. Exiting macro-loop early! <<<\n";
                break;
            }

            // Algorithmic Stall & Convergence Detection
            if (current_iteration_idx > 1) {
                if (surrogate_objective < global_best_objective - 1e-5) { 
                    global_best_objective = surrogate_objective; 
                    outer_stall_count = 0; 
                } else { 
                    outer_stall_count++; 
                }

                if (outer_stall_count >= 1) { 
                    std::cout << ">>> Convergence Threshold Reached: No improvement within 1 iteration. Terminating! <<<\n"; 
                    break; 
                }
                
                double relative_improvement = (prev_objective_value - surrogate_objective) / (prev_objective_value + 1e-9);
                
                if (relative_improvement > 0 && relative_improvement < 1e-3) {
                    slow_progress_count++; 
                } else if (relative_improvement >= 1e-3) {
                    slow_progress_count = 0; 
                }
                
                if (slow_progress_count >= 2) {
                    std::cout << ">>> Convergence Degradation: Progress rate < 1e-3 for 2 consecutive iterations. Terminating! <<<\n";
                    break;
                }
            } else { 
                global_best_objective = surrogate_objective; 
            }

            prev_objective_value = surrogate_objective;
            prev_flow_routing_matrix = flow_routing_matrix;
        }

        // ---------------------------------------------------------
        // Post-Processing & Final Metric Consolidation
        // ---------------------------------------------------------
        auto end_algo = std::chrono::system_clock::now();
        long long duration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(end_algo - start_algo).count();

        std::map<Link, double> eval_capacity_map;
        std::map<Link, double> eval_power_map;
        std::map<Link, double> eval_lambda_map;
        
        for (size_t i = 0; i < col_gen_graph.edge_list.size(); ++i) {
            Link current_link = { 
                static_cast<int>(std::get<0>(col_gen_graph.edge_list[i])), 
                static_cast<int>(std::get<1>(col_gen_graph.edge_list[i])) 
            };
            eval_capacity_map[current_link] = (best_dual_res.optimal_rates.size() > i) ? best_dual_res.optimal_rates[i] : 0.0;
            eval_power_map[current_link] = (best_dual_res.optimal_powers.size() > i) ? best_dual_res.optimal_powers[i] : 0.0;
            eval_lambda_map[current_link] = (best_dual_res.optimal_bandwidths.size() > i) ? best_dual_res.optimal_bandwidths[i] : 0.0;
        }

        auto [final_max_delay, final_sum_delay, final_total_energy, final_delays] = evaluate_network_state(
            traffic_demands, best_flow_routing_matrix, eval_capacity_map, eval_power_map, eval_lambda_map, total_bandwidth_mhz, num_nodes
        );

        int multipath_routing_count = 0;
        for (size_t k = 0; k < traffic_demands.size(); ++k) {
            std::map<int, int> node_outgoing_branches;
            for (const auto& pair : best_flow_routing_matrix[k]) {
                if (pair.second > 0.009) { 
                    node_outgoing_branches[pair.first.first]++;
                }
            }

            bool exhibits_multipath = false;
            for (const auto& branch_info : node_outgoing_branches) {
                if (branch_info.second > 1) { 
                    exhibits_multipath = true;
                    break;
                }
            }
            if (exhibits_multipath) multipath_routing_count++;
        }

        double total_demand_volume = 0.0;
        for (const auto& demand : traffic_demands) {
            total_demand_volume += std::get<2>(demand);
        }
        double energy_efficiency_mbits_per_joule = (final_total_energy > 1e-9) ? (total_demand_volume / final_total_energy) : 0.0;

        std::map<Link, double> edge_traffic_load;
        for (size_t k = 0; k < traffic_demands.size(); ++k) {
            double demand_volume = std::get<2>(traffic_demands[k]);
            for (const auto& pair : best_flow_routing_matrix[k]) {
                if (pair.second > 1e-4) {
                    edge_traffic_load[pair.first] += pair.second * demand_volume;
                }
            }
        }

        double aggregate_congestion = 0.0;
        int utilized_link_count = 0;
        for (const auto& pair : edge_traffic_load) {
            Link current_link = pair.first;
            double link_capacity = eval_capacity_map[current_link]; 
            if (link_capacity > 1e-6) {
                aggregate_congestion += (pair.second / link_capacity); 
                utilized_link_count++;
            }
        }
        double mean_link_congestion = (utilized_link_count > 0) ? (aggregate_congestion / utilized_link_count) : 0.0;

        double sum_delay = 0.0;
        double sum_delay_squared = 0.0;
        size_t valid_commodity_count = final_delays.size();

        for (double delay_val : final_delays) {
            sum_delay += delay_val;
            sum_delay_squared += delay_val * delay_val;
        }

        double jain_fairness_index = (valid_commodity_count > 0 && sum_delay_squared > 1e-12) ?
            ((sum_delay * sum_delay) / (static_cast<double>(valid_commodity_count) * sum_delay_squared)) : 0.0;

        // ==================================================================================
        // Structure Serialization & Final Output Pipeline
        // ==================================================================================
        AlgoResult current_res;

        current_res.iter = current_iteration_idx;
        current_res.name = current_algo;
        current_res.best_F = user_alpha * (final_max_delay / ANCHOR_T) + (1.0 - user_alpha) * (final_total_energy / ANCHOR_E); 
        current_res.active_links = best_active_links;
        current_res.max_delay = final_max_delay;       
        current_res.total_energy = final_total_energy;    
        current_res.multipath_count = multipath_routing_count;
        current_res.time_ms = duration_ms;
        current_res.final_flow_routing_matrix = best_flow_routing_matrix;
        current_res.max_sum_delay = best_T_sum;
        current_res.diff_F = best_diff_F;
        current_res.flow_max_delays = std::move(final_delays);

        current_res.final_p_opt = best_dual_res.optimal_powers;
        current_res.final_r_opt = best_dual_res.optimal_rates;
        current_res.final_l_opt = best_dual_res.optimal_bandwidths;

        current_res.energy_efficiency = energy_efficiency_mbits_per_joule;
        current_res.avg_link_delay = mean_link_congestion; 
        current_res.jain_fairness_index = jain_fairness_index;

        current_res.history_F = current_hist_F;
        current_res.history_T = current_hist_T;
        current_res.history_E = current_hist_E;
        current_res.pd_data = traffic_demands;
        current_res.history_T_sum = current_hist_T_sum;
        current_res.history_diff = current_hist_diff;

        summary_results.push_back(current_res);
    }

    // ==================================================================================
    // Terminal Benchmark Reporting
    // ==================================================================================
    std::cout << "\n\n";
    std::cout << "================================================================================================\n";
    std::cout << "                                 Algorithm Performance Comparison                               \n";
    std::cout << "================================================================================================\n";
    std::cout << std::left
              << std::setw(15) << "Algorithm"
              << "| " << std::setw(10) << "Obj (F)"
              << "| " << std::setw(15) << "Active Links"
              << "| " << std::setw(12) << "T_max (s)"
              << "| " << std::setw(15) << "E_total (J)"
              << "| " << std::setw(10) << "Multipath"
              << "| " << "Time (ms)" << "\n";
    std::cout << "------------------------------------------------------------------------------------------------\n";

    for (const auto& res : summary_results) {
        std::cout << std::left
                  << std::setw(15) << res.name
                  << "| " << std::setw(10) << std::fixed << std::setprecision(4) << res.best_F
                  << "| " << std::setw(15) << (std::to_string(res.active_links) + " / " + std::to_string(col_gen_graph.edge_list.size()))
                  << "| " << std::setw(12) << res.max_delay
                  << "| " << std::setw(15) << res.total_energy
                  << "| " << std::setw(10) << res.multipath_count
                  << "| " << res.time_ms << "\n";
    }
    std::cout << "================================================================================================\n";

    std::cout << "\n>>> Stress Factor Validation = " << stress_factor << "x <<<\n";

    for (const auto& res : summary_results) {
        std::cout << "  -> Algorithm [" << std::left << std::setw(15) << res.name << "] : ";

        if (res.multipath_count > 0) {
            std::cout << "Commodities utilizing multi-path routing: "
                      << res.multipath_count << " / " << traffic_demands.size() << "\n";
        } else {
            std::cout << "Commodities utilizing multi-path routing: 0\n";
        }
    }
    std::cout << "================================================================================\n\n";

    auto end_main = system_clock::now();
    std::cout << "\n[Execution Engine] Total pipeline execution time: " 
              << duration_cast<milliseconds>(end_main - start_main).count() << " ms\n";

    return summary_results;
}

