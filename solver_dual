// =========================================================
// Mathematical Utilities
// =========================================================

constexpr double kDualEpsilon = 1e-9;

/**
 * @brief Performs Euclidean projection onto a scaled simplex.
 * Minimizes ||x - y||^2 subject to sum(x) = alpha, x >= 0.
 * @param target_vector The vector y to be projected.
 * @param simplex_scale The sum constraint alpha.
 * @return std::vector<double> The projected vector x.
 * @note Utilized within Lagrangian Dual Decomposition to enforce sum constraints 
 * on dual variables (e.g., path delays) while maintaining non-negativity.
 * Time complexity is O(K log K) due to the sorting step, where K is the vector dimension.
 */
std::vector<double> project_simplex(std::vector<double>& target_vector, double simplex_scale) {
    int dim = target_vector.size();
    if (dim == 0) return {};

    std::vector<double> sorted_u = target_vector;
    // 1. Sort in descending order
    std::sort(sorted_u.begin(), sorted_u.end(), std::greater<double>());

    // 2. Find the pivot index rho
    int rho = -1;
    double cumulative_sum = 0.0;
    for (int i = 0; i < dim; ++i) {
        cumulative_sum += sorted_u[i];
        double root_test = sorted_u[i] + (1.0 / (i + 1)) * (simplex_scale - cumulative_sum);
        if (root_test > 0) {
            rho = i;
        }
    }

    // 3. Compute the Lagrange multiplier theta
    double sum_rho = 0.0;
    for (int i = 0; i <= rho; ++i) {
        sum_rho += sorted_u[i];
    }
    double theta = (1.0 / (rho + 1)) * (simplex_scale - sum_rho);

    // 4. Project and enforce non-negativity
    std::vector<double> projected_x(dim);
    for (int i = 0; i < dim; ++i) {
        projected_x[i] = std::max(0.0, target_vector[i] + theta);
    }
    
    return projected_x;
}

// =========================================================
// Dual Decomposition Solvers (Part 1)
// =========================================================

/**
 * @brief Solves the physical link sub-problem for bandwidth and time allocations via Coordinate Descent.
 * @note Optimizes the localized Lagrangian function Phi_ij(l, t). Reduces computational overhead 
 * by terminating after 3 iterations, sufficient for convergence under the Primal-Dual Algorithm framework.
 */
void solve_link_subproblem(
    double& optimal_bandwidth, 
    double& optimal_time,
    double traffic_demand_ij,
    double channel_snr_gain,
    double dual_multiplier_lambda,
    double internal_penalty_sigma,
    double dual_multiplier_lambda_ij,
    double node_max_power,
    double fairness_alpha,
    double convergence_epsilon,
    double total_system_bandwidth_mhz 
) {
    constexpr double kMinResourceVariance = 1e-3;
    optimal_bandwidth = std::max(optimal_bandwidth, kMinResourceVariance);
    optimal_time = std::max(optimal_time, kMinResourceVariance);

    double power_penalty_coeff = convergence_epsilon + internal_penalty_sigma;
    double energy_weight = 1.0 - fairness_alpha;
    double inverse_snr_gain = 1.0 / channel_snr_gain;

    // Coordinate Descent: Fast convergence threshold set to 3 iterations
    for (int iter = 0; iter < 3; ++iter) {

        // ==========================================
        // --- Step A: Optimize Bandwidth (l) holding Time (t) constant ---
        // ==========================================
        {
            double search_low = kMinResourceVariance;
            // Adaptive search ceiling bounded by physical spectrum to prevent numerical overflows
            double search_high = std::max(total_system_bandwidth_mhz * 2.0, 100.0);

            for (int bin = 0; bin < 35; ++bin) { 
                double mid_bandwidth = (search_low + search_high) / 2.0;
                double current_exponent = traffic_demand_ij / (mid_bandwidth * optimal_time);

                // Math Defense 1: Prevent std::pow catastrophic overflow
                if (current_exponent > 50.0) {
                    search_low = mid_bandwidth;
                    continue;
                }

                double exponential_term = std::pow(2.0, current_exponent);
                double required_power = mid_bandwidth * inverse_snr_gain * (exponential_term - 1.0);

                // Math Defense 2: Strict Power Clamping 
                if (required_power > node_max_power) {
                    search_low = mid_bandwidth;
                    continue;
                }

                double dP_dl = inverse_snr_gain * (exponential_term - 1.0 - current_exponent * std::log(2.0) * exponential_term);
                double derivative = dP_dl * (energy_weight * optimal_time + power_penalty_coeff) + dual_multiplier_lambda;

                if (derivative > 0) {
                    search_high = mid_bandwidth;
                } else {
                    search_low = mid_bandwidth;
                }
            }
            optimal_bandwidth = (search_low + search_high) / 2.0;
        }

        // ==========================================
        // --- Step B: Optimize Time (t) holding Bandwidth (l) constant ---
        // ==========================================
        {
            constexpr double kMaxQosDelay = 100.0; 

            double max_snr = (node_max_power * channel_snr_gain) / optimal_bandwidth;
            double max_rate = optimal_bandwidth * std::log2(1.0 + max_snr);

            double physical_min_time = (max_rate > 1e-9) ? (traffic_demand_ij / max_rate) : 99999.0;

            double search_low = physical_min_time;
            double search_high = std::max(physical_min_time, kMaxQosDelay);

            if (search_high - search_low < 1e-4) {
                optimal_time = search_high;
            } else {
                for (int bin = 0; bin < 35; ++bin) {
                    double mid_time = (search_low + search_high) / 2.0;
                    double current_exponent = traffic_demand_ij / (optimal_bandwidth * mid_time);

                    double exponential_term = std::pow(2.0, current_exponent);
                    double required_power = optimal_bandwidth * inverse_snr_gain * (exponential_term - 1.0);

                    if (required_power > node_max_power) {
                        search_low = mid_time;
                        continue;
                    }

                    double dP_dt = -(inverse_snr_gain * traffic_demand_ij * std::log(2.0) / (mid_time * mid_time)) * exponential_term;
                    double dE_dt = inverse_snr_gain * optimal_bandwidth * (exponential_term - 1.0 - current_exponent * std::log(2.0) * exponential_term);
                    double objective_derivative = energy_weight * dE_dt + power_penalty_coeff * dP_dt + dual_multiplier_lambda_ij;

                    if (objective_derivative > 0) {
                        search_high = mid_time;
                    } else {
                        search_low = mid_time;
                    }
                }
                optimal_time = (search_low + search_high) / 2.0;
            }
        }
    }
}

// =========================================================
// Game-Theoretic Greedy Baseline (Resource Allocation Only)
// =========================================================

OptimizationResult run_game_greedy_allocation(
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& edge_list,
    int num_nodes,
    const std::vector<double>& node_max_powers,
    double total_bandwidth_mhz,
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& commodity_demands,
    const std::vector<std::map<Link, double>>& current_flow_routing, 
    double noise_density_dbm_per_mhz
) {
    OptimizationResult result;
    std::size_t num_edges = edge_list.size();
    std::size_t num_flows = commodity_demands.size();
    
    double noise_power_spectral_density_w_mhz = std::pow(10.0, (noise_density_dbm_per_mhz - 30.0) / 10.0);
    constexpr double kEps = 1e-9;

    // ==========================================
    // 1. Graph Topology & O(1) Index Mapping
    // ==========================================
    std::vector<std::vector<std::pair<int, int>>> adjacency_indices(num_nodes);
    std::vector<double> channel_gains(num_edges);
    std::vector<int> out_degrees(num_nodes, 0);
    std::map<Link, int> link_to_index_map; 

    for (std::size_t e = 0; e < num_edges; ++e) {
        int u = static_cast<int>(std::get<0>(edge_list[e]));
        int v = static_cast<int>(std::get<1>(edge_list[e]));
        Link current_link = { u, v };
        
        link_to_index_map[current_link] = static_cast<int>(e);
        adjacency_indices[u].push_back({ v, static_cast<int>(e) });
        out_degrees[u]++;

        double distance_meters = std::get<2>(edge_list[e]);
        double distance_km = std::max(0.001, distance_meters / 1000.0);
        double path_loss_db = 128.1 + 37.6 * std::log10(distance_km);
        channel_gains[e] = std::pow(10.0, -path_loss_db / 10.0);
    }

    // ==========================================
    // 2. Physical Traffic Compilation 
    // ==========================================
    std::vector<double> actual_flow_volumes(num_edges, 0.0);
    int active_edge_count = 0;

    for (std::size_t k = 0; k < num_flows; ++k) {
        double traffic_volume = std::get<2>(commodity_demands[k]);
        for (const auto& pair : current_flow_routing[k]) {
            if (pair.second > 1e-5 && link_to_index_map.count(pair.first)) {
                int e = link_to_index_map[pair.first];
                actual_flow_volumes[e] += pair.second * traffic_volume;
            }
        }
    }

    for (std::size_t e = 0; e < num_edges; ++e) {
        if (actual_flow_volumes[e] > kEps) {
            active_edge_count++;
        }
    }

    // ==========================================
    // 3. Heuristic Resource Initialization 
    // ==========================================
    std::vector<double> power_vector(num_edges, 0.0);
    std::vector<double> bandwidth_vector(num_edges, kEps); 

    // Target bandwidth allocation exclusively to active edges
    double bandwidth_per_active_edge = (active_edge_count > 0) ? (total_bandwidth_mhz / active_edge_count) : 0.0;

    for (std::size_t e = 0; e < num_edges; ++e) {
        int u = static_cast<int>(std::get<0>(edge_list[e]));
        if (actual_flow_volumes[e] > kEps) {
            bandwidth_vector[e] = bandwidth_per_active_edge;
            power_vector[e] = node_max_powers[u] / std::max(1, out_degrees[u]);
        }
    }

    // ==========================================
    // 4. Iterative Potential Game (Localized Power Swapping)
    // ==========================================
    auto eval_total_delay = [&]() -> double {
        double sum_delay = 0.0;
        for (std::size_t e = 0; e < num_edges; ++e) {
            if (actual_flow_volumes[e] > kEps) {
                double snr = (power_vector[e] * channel_gains[e]) / (noise_power_spectral_density_w_mhz * bandwidth_vector[e]);
                double capacity = bandwidth_vector[e] * std::log2(1.0 + snr);
                sum_delay += actual_flow_volumes[e] / std::max(capacity, kEps);
            }
        }
        return sum_delay;
    };

    std::mt19937 rng(42);
    std::uniform_real_distribution<double> rand_ratio(0.05, 0.3);

    double current_objective = eval_total_delay();
    
    for (int iter = 0; iter < 50; ++iter) {
        bool globally_improved = false;
        for (int u = 0; u < num_nodes; ++u) {
            std::vector<int> node_active_edges;
            for (const auto& edge : adjacency_indices[u]) {
                if (actual_flow_volumes[edge.second] > kEps) {
                    node_active_edges.push_back(edge.second);
                }
            }
            if (node_active_edges.size() >= 2) {
                int e1 = node_active_edges[rng() % node_active_edges.size()];
                int e2 = node_active_edges[rng() % node_active_edges.size()];
                if (e1 == e2) continue;

                double power_delta = power_vector[e1] * rand_ratio(rng);
                power_vector[e1] -= power_delta;
                power_vector[e2] += power_delta;

                double new_objective = eval_total_delay();
                if (new_objective < current_objective - 1e-5) {
                    current_objective = new_objective;
                    globally_improved = true;
                } else {
                    // Revert 
                    power_vector[e1] += power_delta;
                    power_vector[e2] -= power_delta;
                }
            }
        }
        if (!globally_improved) break;
    }

    // ==========================================
    // 5. Finalize Shannon Capacity Resolutions
    // ==========================================
    std::vector<double> rate_vector(num_edges, kEps);
    std::map<Link, double> rate_map;
    std::map<Link, double> power_map;
    std::map<Link, double> bandwidth_map;

    for (std::size_t e = 0; e < num_edges; ++e) {
        Link current_link = { static_cast<int>(std::get<0>(edge_list[e])), static_cast<int>(std::get<1>(edge_list[e])) };
        if (actual_flow_volumes[e] > kEps) {
            double snr = (power_vector[e] * channel_gains[e]) / (noise_power_spectral_density_w_mhz * bandwidth_vector[e]);
            rate_vector[e] = std::max(bandwidth_vector[e] * std::log2(1.0 + snr), kEps);
        }
        rate_map[current_link] = rate_vector[e];
        power_map[current_link] = power_vector[e];
        bandwidth_map[current_link] = bandwidth_vector[e];
    }

    // ==========================================
    // 6. Invoke Global Arbiter (evaluate_network_state)
    // ==========================================
    auto [final_max_delay, final_sum_delay, final_total_energy, final_delays] = evaluate_network_state(
        commodity_demands, current_flow_routing, rate_map, power_map, bandwidth_map, total_bandwidth_mhz, num_nodes
    );
    
    // ==========================================
    // 7. Assemble OptimizationResult
    // ==========================================
    result.optimal_bandwidths = bandwidth_vector;
    result.optimal_powers = power_vector;
    result.optimal_rates = rate_vector;
    
    result.optimal_transmission_times.resize(num_edges, 0.0);
    for (std::size_t e = 0; e < num_edges; ++e) {
        result.optimal_transmission_times[e] = actual_flow_volumes[e] / rate_vector[e];
    }

    result.max_end_to_end_delay = final_max_delay;
    result.max_expected_sum_delay = final_sum_delay;
    result.total_system_energy = final_total_energy;
    result.commodity_max_delays = std::move(final_delays);
    
    return result;
}


