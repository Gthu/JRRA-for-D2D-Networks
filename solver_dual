/**
 * @brief Executes the Primal-Dual Algorithm (Dual Decomposition) for distributed resource allocation.
 * @note This is the core optimizer for Network Utility Maximization (NUM). It isolates the link-level 
 * bandwidth/power coupling by dualizing the constraints via Shadow Prices ($\lambda, \sigma, \gamma$).
 */
OptimizationResult run_dual_decomposition_solver(
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& edge_list,
    int num_nodes,
    const std::vector<double>& node_max_powers,
    double total_bandwidth_mhz,
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& commodity_demands,
    const std::vector<std::map<Link, double>>& current_flow_routing,
    double noise_density_dbm_per_mhz,
    double fairness_alpha,
    double convergence_epsilon
) {
    int num_edges = edge_list.size();
    int num_flows = commodity_demands.size();
    
    double noise_power_spectral_density_w_mhz = std::pow(10.0, (noise_density_dbm_per_mhz - 30.0) / 10.0);

    // ==========================================
    // 0. Topology Pre-computation (Performance Critical)
    // ==========================================
    std::vector<double> channel_gain_vector(num_edges);
    std::vector<double> aggregate_edge_load(num_edges, 0.0);
    std::vector<double> snr_gain_per_mhz(num_edges, 0.0); // Pre-computed H / N0
    std::vector<bool> is_edge_active(num_edges, false); 
    
    // O(1) Cache: Maps each physical edge to its constituent flow fractions (rho coefficients)
    // Pair: <commodity_id, rho_value>
    std::vector<std::vector<std::pair<int, double>>> edge_commodity_mapping(num_edges);

    for (int e = 0; e < num_edges; ++e) {
        // 1. Compute Physical Channel Dynamics (h)
        double distance_meters = std::get<2>(edge_list[e]);
        double distance_km = std::max(0.001, distance_meters / 1000.0);
        double path_loss_db = 128.1 + 37.6 * std::log10(distance_km);
        
        channel_gain_vector[e] = std::pow(10.0, -path_loss_db / 10.0);
        
        // Overflow Defense: Pre-calculate the SNR gain coefficient per MHz.
        // Prevents extreme floating-point truncation errors deep inside the coordinate descent loops.
        snr_gain_per_mhz[e] = channel_gain_vector[e] / noise_power_spectral_density_w_mhz;

        // 2. Aggregate Total Load (D_e) and Commodity Mapping
        int u = static_cast<int>(std::get<0>(edge_list[e]));
        int v = static_cast<int>(std::get<1>(edge_list[e]));
        Link current_link = { u, v };

        double edge_total_load = 0.0;
        
        for (int k = 0; k < num_flows; ++k) {
            auto iterator = current_flow_routing[k].find(current_link);
            if (iterator != current_flow_routing[k].end()) {
                double routing_fraction = iterator->second;
                
                // Utilize the solver's convergence_epsilon for strict topological truncation
                if (routing_fraction > convergence_epsilon) {
                    double traffic_volume = std::get<2>(commodity_demands[k]);
                    // Dimensionality alignment (MHz to Mbps-equivalent demand)
                    edge_total_load += routing_fraction * traffic_volume;
                    edge_commodity_mapping[e].emplace_back(k, routing_fraction);
                }
            }
        }

        aggregate_edge_load[e] = edge_total_load;
        if (edge_total_load > 1e-12) {
            is_edge_active[e] = true; // Optimization flag for primal/dual loops
        }
    }

    // ==========================================
    // 1. Transform Routing Fractions to \rho Coefficients
    // ==========================================
    int count_active_edges = 0;
    
    for (int e = 0; e < num_edges; ++e) {
        if (is_edge_active[e]) {
            count_active_edges++;
            for (auto& flow_data : edge_commodity_mapping[e]) {
                int k = flow_data.first;
                double routing_fraction = flow_data.second;
                double traffic_volume = std::get<2>(commodity_demands[k]);

                // Compute \rho = (x_e^k * M^k) / D_e
                // Zero-division risk eliminated by the is_edge_active flag.
                flow_data.second = (routing_fraction * traffic_volume) / aggregate_edge_load[e];
            }
        }
    }

    // ==========================================
    // 2. Primal & Dual Variable Initialization 
    // ==========================================
    double initial_bandwidth_per_edge = (count_active_edges > 0) ? (total_bandwidth_mhz / count_active_edges) : 0.0;

    std::vector<double> bandwidth_allocations(num_edges, 0.0);
    std::vector<double> time_allocations(num_edges, 0.0);

    for (int e = 0; e < num_edges; ++e) {
        if (is_edge_active[e]) {
            int source_node = static_cast<int>(std::get<0>(edge_list[e]));
            double initial_power_tx = node_max_powers[source_node]; 
            
            bandwidth_allocations[e] = initial_bandwidth_per_edge;

            // Compute realistic initial SNR based on max power and uniform bandwidth
            double baseline_snr = (initial_power_tx * snr_gain_per_mhz[e]) / bandwidth_allocations[e];
            
            // Heuristic Time Initialization: D_e / C_e
            // Prevents massive initial gradients (t_e - D_e / l_e)
            double estimated_link_capacity = bandwidth_allocations[e] * std::log2(1.0 + baseline_snr); 
            estimated_link_capacity = std::max(estimated_link_capacity, 1e-6);
            time_allocations[e] = aggregate_edge_load[e] / estimated_link_capacity;
        }
    }

    // Shadow Prices Initialization
    double price_lambda_bandwidth = 1e-5;
    std::vector<double> price_sigma_power(num_nodes, 1e-5);
    std::vector<double> price_gamma_delay(num_flows, fairness_alpha / std::max(1, num_flows));
    
    constexpr double kMaxShadowPrice = 10000.0;
    
    // Diminishing Step Size Anchors
    double step_anchor_lambda = 0.01;
    double step_anchor_sigma = 0.01;
    double step_anchor_gamma = 0.05;

    constexpr double kEpsilonDual = 1e-4;
    constexpr double kEpsilonFeasible = 1e-3;

    int max_iterations = 500;
    int patience_limit = 50;
    int consecutive_stall_count = 0;

    double best_observed_metric = 1e12; 

    // The Doomsday Pocket (Safe state preservation)
    std::vector<double> pocket_bandwidth = bandwidth_allocations;
    std::vector<double> pocket_time = time_allocations;

    // ==========================================
    // 3. Main Primal-Dual Iteration Loop
    // ==========================================
    for (int iter = 0; iter < max_iterations; ++iter) {
        
        // Strictly Squared Summable, but not Summable (SSBNS) step sizes
        double current_step_lambda = step_anchor_lambda / (iter + 1.0);
        double current_step_sigma = step_anchor_sigma / (iter + 1.0);
        double current_step_gamma = step_anchor_gamma / (iter + 1.0);

        // State preservation for convergence drift analysis
        double previous_lambda = price_lambda_bandwidth;
        std::vector<double> previous_sigma = price_sigma_power;
        std::vector<double> previous_gamma = price_gamma_delay;

        // --- Step A: Distributed Primal Update ---
        for (int e = 0; e < num_edges; ++e) {
            
            // O(1) bypass for topological dead-ends
            if (!is_edge_active[e]) {
                bandwidth_allocations[e] = 0.0;
                time_allocations[e] = 0.0;
                continue;
            }

            int u = static_cast<int>(std::get<0>(edge_list[e]));

            // Aggregate Delay Shadow Price: \Lambda_{ij} = \sum (\gamma_k * \rho_{ij}^k)
            double aggregate_delay_price = 0.0;
            for (const auto& flow_info : edge_commodity_mapping[e]) {
                int k = flow_info.first;
                double rho_fraction = flow_info.second;
                aggregate_delay_price += price_gamma_delay[k] * rho_fraction;
            }

            // CRITICAL: Subproblem coordinate descent. 
            // Passes snr_gain_per_mhz directly to avert internal extreme division faults.
            solve_link_subproblem(
                bandwidth_allocations[e], time_allocations[e],      
                aggregate_edge_load[e], snr_gain_per_mhz[e],      
                price_lambda_bandwidth, price_sigma_power[u], aggregate_delay_price,    
                node_max_powers[u],              // Absolute physical constraint wall
                fairness_alpha, convergence_epsilon,          
                total_bandwidth_mhz
            );

            // Safety floor clamping
            bandwidth_allocations[e] = std::max(bandwidth_allocations[e], convergence_epsilon);
            time_allocations[e] = std::max(time_allocations[e], convergence_epsilon);
        }

        // --- Step B: Dual Update (Subgradient Ascent) ---

        // 1. Global Bandwidth Constraint Price (\lambda)
        double sum_allocated_bandwidth = std::accumulate(bandwidth_allocations.begin(), bandwidth_allocations.end(), 0.0);
        double grad_lambda = (sum_allocated_bandwidth - total_bandwidth_mhz) / total_bandwidth_mhz;

        // Graceful Gradient Clipping via std::clamp
        grad_lambda = std::clamp(grad_lambda, -2.0, 5.0); 
        price_lambda_bandwidth = std::max(0.0, price_lambda_bandwidth + current_step_lambda * grad_lambda);
        price_lambda_bandwidth = std::min(price_lambda_bandwidth, kMaxShadowPrice);

        // 2. Node Power Constraint Prices (\sigma_i)
        std::vector<double> aggregate_node_power(num_nodes, 0.0);

        for (int e = 0; e < num_edges; ++e) {
            if (!is_edge_active[e]) continue;

            double safe_bandwidth = std::max(bandwidth_allocations[e], convergence_epsilon);
            double safe_time = std::max(time_allocations[e], convergence_epsilon);

            double capacity_exponent = aggregate_edge_load[e] / (safe_bandwidth * safe_time);
            double required_tx_power = 0.0;
            int u = static_cast<int>(std::get<0>(edge_list[e]));

            // Absolute Physical Wall Defense
            if (capacity_exponent > 50.0) {
                // Catastrophic Violation: Power diverges to inf. 
                // Artificially assign 2x the max power to trigger a massive, immediate 
                // gradient spike in \sigma_u, forcing the primal step to retreat next iteration.
                required_tx_power = node_max_powers[u] * 2.0;
            } else {
                required_tx_power = (std::pow(2.0, capacity_exponent) - 1.0) * safe_bandwidth / snr_gain_per_mhz[e];
            }

            aggregate_node_power[u] += required_tx_power;
        }

        double max_violation_ratio = -std::numeric_limits<double>::infinity();
        
        for (int i = 0; i < num_nodes; ++i) {
            if (node_max_powers[i] > convergence_epsilon) {
                double raw_grad_sigma = (aggregate_node_power[i] - node_max_powers[i]) / node_max_powers[i];

                max_violation_ratio = std::max(max_violation_ratio, raw_grad_sigma);
                
                double clipped_grad_sigma = std::clamp(raw_grad_sigma, -2.0, 5.0);
                price_sigma_power[i] = std::max(0.0, price_sigma_power[i] + current_step_sigma * clipped_grad_sigma);
                price_sigma_power[i] = std::min(price_sigma_power[i], kMaxShadowPrice);
            }
        }

        // 3. User Fairness Constraint Prices (\gamma_k) via Simplex Projection
        std::vector<double> gamma_gradient(num_flows, 0.0);

        for (int e = 0; e < num_edges; ++e) {
            if (!is_edge_active[e]) continue;

            for (const auto& flow_info : edge_commodity_mapping[e]) {
                int k = flow_info.first;
                double rho_fraction = flow_info.second;
                
                // time_allocations[e] is strictly positive due to prior clamping
                gamma_gradient[k] += rho_fraction * time_allocations[e];
            }
        }

        std::vector<double> next_gamma_state = price_gamma_delay;
        
        for (int k = 0; k < num_flows; ++k) {
            // Gentle clipping to prevent extreme outlier delays (e.g., 500s penalty) 
            // from annihilating the simplex geometry in a single step.
            double safe_gamma_grad = std::clamp(gamma_gradient[k], 0.0, 10.0);
            next_gamma_state[k] += current_step_gamma * safe_gamma_grad;
        }

        // Project onto the \alpha simplex: \sum \gamma_k = \alpha
        price_gamma_delay = project_simplex(next_gamma_state, fairness_alpha);

        // ==========================================
        // 4. Convergence Diagnostics & The Doomsday Pocket
        // ==========================================
        double bandwidth_violation_ratio = std::max(0.0, sum_allocated_bandwidth - total_bandwidth_mhz) / total_bandwidth_mhz;
        double maximum_power_violation = 0.0;
        
        for (int i = 0; i < num_nodes; ++i) {
            if (node_max_powers[i] > convergence_epsilon) {
                double node_p_viol = std::max(0.0, aggregate_node_power[i] - node_max_powers[i]) / node_max_powers[i];
                maximum_power_violation = std::max(maximum_power_violation, node_p_viol);
            }
        }

        bool state_is_feasible = (bandwidth_violation_ratio < kEpsilonFeasible) && (maximum_power_violation < kEpsilonFeasible);
        double total_system_violation = bandwidth_violation_ratio + maximum_power_violation;

        // L2 Norm Drift Calculus (Standard NUM Convergence Metric)
        auto calculate_l2_drift = [](const std::vector<double>& current, const std::vector<double>& previous) {
            double numerator_sq = 0.0, denominator_sq = 0.0;
            for (std::size_t i = 0; i < current.size(); ++i) {
                double diff = current[i] - previous[i];
                numerator_sq += diff * diff;
                denominator_sq += previous[i] * previous[i];
            }
            return std::sqrt(numerator_sq) / (std::sqrt(denominator_sq) + 1e-9); 
        };

        double dual_state_drift = 0.0;

        double lambda_state_drift = std::abs(price_lambda_bandwidth - previous_lambda) / (previous_lambda + 1e-9);
        dual_state_drift = std::max(dual_state_drift, lambda_state_drift);

        double sigma_state_drift = calculate_l2_drift(price_sigma_power, previous_sigma);
        dual_state_drift = std::max(dual_state_drift, sigma_state_drift);

        double gamma_state_drift = calculate_l2_drift(price_gamma_delay, previous_gamma);
        dual_state_drift = std::max(dual_state_drift, gamma_state_drift);

        double aggregate_max_violation = std::max(grad_lambda, max_violation_ratio);

        // ==========================================
        // 5. Dynamic Early Stopping & The Doomsday Pocket
        // ==========================================
        
        // Define minimum threshold to qualify as a substantial algorithmic descent
        constexpr double kMinSubstantialImprovement = 1e-6;

        if (state_is_feasible && dual_state_drift < kEpsilonDual) {
            pocket_bandwidth = bandwidth_allocations; 
            pocket_time = time_allocations;
            break; // Perfect Convergence achieved
        }

        if (state_is_feasible) {
            // Strictly require substantive drift reduction to reset patience
            if (dual_state_drift < best_observed_metric - kMinSubstantialImprovement) {
                best_observed_metric = dual_state_drift;
                pocket_bandwidth = bandwidth_allocations;
                pocket_time = time_allocations;
                consecutive_stall_count = 0; 
            } else {
                // Feasible, but descent is marginal (likely due to step decay). Consume patience.
                consecutive_stall_count++;
            }
        } else {
            // Unfeasible state progression also consumes patience to prevent infinite loops.
            consecutive_stall_count++;

            // The Doomsday Pocket: Salvaging the "Least Worst" violation state 
            static double minimum_historical_violation = 1e9;
            if (total_system_violation < minimum_historical_violation) {
                minimum_historical_violation = total_system_violation;
                
                // Only update the pocket if we have never seen a feasible state
                if (best_observed_metric > 1e11) { 
                    pocket_bandwidth = bandwidth_allocations;
                    pocket_time = time_allocations;
                    
                    // Minor patience reward for discovering a strictly less-violating boundary
                    consecutive_stall_count = std::max(0, consecutive_stall_count - 5);
                }
            }
        }

        if (consecutive_stall_count >= patience_limit) {
            std::cout << "[Dual Decomposition] Early Stop triggered. Patience limit (" << patience_limit << ") exhausted.\n";
            break;
        }
    } // ---------- End Main Dual Loop ----------

    // ==========================================
    // Post-Processing: Restore Optimal State & Enforce Physical Laws
    // ==========================================
    
    // Retrieve the pinnacle state from the preservation pocket
    bandwidth_allocations = pocket_bandwidth;
    time_allocations = pocket_time;

    OptimizationResult final_result;
    final_result.optimal_bandwidths = bandwidth_allocations;
    final_result.optimal_transmission_times = time_allocations;
    final_result.optimal_powers.resize(num_edges, 0.0);
    final_result.optimal_rates.resize(num_edges, 0.0);

    double computed_total_energy = 0.0;

    for (int e = 0; e < num_edges; ++e) {
        if (is_edge_active[e]) {
            int source_node = static_cast<int>(std::get<0>(edge_list[e]));
            
            double safe_bandwidth = std::max(bandwidth_allocations[e], convergence_epsilon);
            double safe_time = std::max(time_allocations[e], convergence_epsilon);

            double capacity_exponent = aggregate_edge_load[e] / (safe_bandwidth * safe_time);
            double physical_power = 0.0;

            if (capacity_exponent > 50.0) {
                // Internal accounting penalty for severe overload
                physical_power = node_max_powers[source_node] * 2.0; 
            } else {
                physical_power = (std::pow(2.0, capacity_exponent) - 1.0) * safe_bandwidth / snr_gain_per_mhz[e];
            }

            // --- Physical Law Re-assertion ---
            // 1. Strict truncation of transmit power
            final_result.optimal_powers[e] = std::clamp(physical_power, 0.0, node_max_powers[source_node]);

            // 2. Capacity must be re-calculated based on the truncated power via Shannon's formula.
            // DO NOT use the aspirational D/t ratio, as it violates the newly clamped physical boundary.
            double truncated_snr = (final_result.optimal_powers[e] * snr_gain_per_mhz[e]) / safe_bandwidth;
            double actual_shannon_capacity = safe_bandwidth * std::log2(1.0 + truncated_snr);
            final_result.optimal_rates[e] = std::max(actual_shannon_capacity, convergence_epsilon);

            computed_total_energy += final_result.optimal_powers[e] * safe_time;
        }
    }
    
    final_result.total_system_energy = computed_total_energy;

    // ===================================================================
    // Dual-Track Delay Audit Engine:
    // Track A: Expected Sum Delay (Linear Accumulation)
    // Track B: Physical Worst-Case Delay (DFS Memoization DAG Search)
    // ===================================================================
    
    double computed_max_end_to_end_delay = 0.0;
    double computed_max_sum_delay = 0.0;
    constexpr double kMaxDelayPenalty = 1e8;

    // Pre-allocate DFS memory structures to prevent heap fragmentation
    std::vector<std::vector<std::pair<int, double>>> subgraph_adjacency(num_nodes);
    std::vector<double> delay_memoization(num_nodes, -1.0);
    std::vector<bool> recursion_visited_stack(num_nodes, false);

    std::vector<double> commodity_max_delays(num_flows, kMaxDelayPenalty);

    for (int k = 0; k < num_flows; ++k) {
        int source_node = static_cast<int>(std::get<0>(commodity_demands[k]));
        int target_node = static_cast<int>(std::get<1>(commodity_demands[k]));
        double traffic_volume = std::get<2>(commodity_demands[k]);

        // Track A Setup: Mathematical Expectation Accumulator
        double expected_commodity_delay = 0.0;
        bool possesses_valid_flow = false;

        for (auto& adjacency_list : subgraph_adjacency) {
            adjacency_list.clear();
        }

        for (int e = 0; e < num_edges; ++e) {
            if (is_edge_active[e]) {
                int u = static_cast<int>(std::get<0>(edge_list[e]));
                int v = static_cast<int>(std::get<1>(edge_list[e]));
                Link current_link = { u, v };

                auto iterator = current_flow_routing[k].find(current_link);
                
                // Filter microscopic numerical dust flows using strict epsilon threshold
                if (iterator != current_flow_routing[k].end() && iterator->second > convergence_epsilon) {
                    double routing_fraction = iterator->second;

                    // Revert to original Lagrangian definition of edge traversal time t_ij
                    double share_ratio = (routing_fraction * traffic_volume) / aggregate_edge_load[e];
                    double edge_traversal_time = share_ratio * time_allocations[e];

                    // Track A accumulation
                    expected_commodity_delay += edge_traversal_time;

                    // Track B graph construction (strictly utilizing t_ij as edge weights)
                    subgraph_adjacency[u].push_back({ v, edge_traversal_time });

                    possesses_valid_flow = true;
                }
            }
        }

        // Track B Execution: Cycle-Immune DFS for Topographical Bottlenecks
        if (possesses_valid_flow) {
            std::fill(delay_memoization.begin(), delay_memoization.end(), -1.0);
            std::fill(recursion_visited_stack.begin(), recursion_visited_stack.end(), false);

            std::function<double(int)> search_longest_path = [&](int current_vertex) -> double {
                if (current_vertex == target_node) return 0.0;
                if (recursion_visited_stack[current_vertex]) return -kMaxDelayPenalty;
                if (delay_memoization[current_vertex] >= -0.5) return delay_memoization[current_vertex];

                recursion_visited_stack[current_vertex] = true;
                double max_downstream_delay = -kMaxDelayPenalty;

                for (const auto& edge : subgraph_adjacency[current_vertex]) {
                    int next_vertex = edge.first;
                    double link_delay = edge.second; 
                    double downstream_delay = search_longest_path(next_vertex);

                    if (downstream_delay > -kMaxDelayPenalty / 2.0) {
                        max_downstream_delay = std::max(max_downstream_delay, link_delay + downstream_delay);
                    }
                }

                recursion_visited_stack[current_vertex] = false;
                return delay_memoization[current_vertex] = max_downstream_delay;
            };

            double physical_max_path_delay = search_longest_path(source_node);

            // =========================================================
            // 🚨 Ultimate Verdict: Strict Subsumption Logic
            // Track A (Math) is only validated IF Track B (Physics) confirms connectivity.
            // =========================================================
            if (physical_max_path_delay > -0.5 && physical_max_path_delay < kMaxDelayPenalty / 2.0) {
                // VERDICT: Connectivity Confirmed

                // 1. Commit Track B metrics
                computed_max_end_to_end_delay = std::max(computed_max_end_to_end_delay, physical_max_path_delay);
                commodity_max_delays[k] = physical_max_path_delay;

                // 2. Commit Track A metrics (now mathematically legal)
                computed_max_sum_delay = std::max(computed_max_sum_delay, expected_commodity_delay);
            } else {
                // VERDICT: Pathological Disconnection (Fractured sub-paths)

                // 1. Track B Penalty
                computed_max_end_to_end_delay = std::max(computed_max_end_to_end_delay, kMaxDelayPenalty);
                commodity_max_delays[k] = kMaxDelayPenalty;

                // 2. Track A Contagion Penalty (Fractured flows cannot accrue valid math expectations)
                computed_max_sum_delay = std::max(computed_max_sum_delay, kMaxDelayPenalty);
            }
        } else {
            // VERDICT: Total Flow Starvation (Zero connectivity)
            computed_max_end_to_end_delay = std::max(computed_max_end_to_end_delay, kMaxDelayPenalty);
            computed_max_sum_delay = std::max(computed_max_sum_delay, kMaxDelayPenalty); 
            commodity_max_delays[k] = kMaxDelayPenalty;
        }
    }
    
    // Dispatch Results
    final_result.max_end_to_end_delay = computed_max_end_to_end_delay;
    final_result.max_expected_sum_delay = computed_max_sum_delay;
    final_result.commodity_max_delays = std::move(commodity_max_delays);

    return final_result;
}
