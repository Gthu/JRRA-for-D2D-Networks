// ==============================================================================
// Static Equal Allocation Baseline & SPFA DAG Delay Evaluation
// ==============================================================================

/**
 * @brief Executes a static, uniform resource allocation baseline and evaluates end-to-end delays.
 * @param edge_list Master list of network edges representing physical topology.
 * @param commodity_demands Traffic demand matrix specifying source, destination, and volume.
 * @param current_flow_routing The pre-computed flow routing matrix to be evaluated.
 * @param total_bandwidth_mhz Total available spectrum bandwidth in the system.
 * @param max_power_per_node Maximum transmission power constraint per node.
 * @param noise_density_dbm_per_mhz Additive White Gaussian Noise (AWGN) power spectral density.
 * @return OptimizationResult Structure encapsulating the uniform allocations and evaluated system metrics.
 * @note This module functions as a "dumb" baseline, evenly distributing bandwidth among all active links 
 * and splitting node power uniformly across active outgoing edges. End-to-end maximum delays are rigorously 
 * audited using a Shortest Path Faster Algorithm (SPFA) topological sort to detect and penalize routing loops.
 */
OptimizationResult run_static_equal_allocation(
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& edge_list, 
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& commodity_demands,
    const std::vector<std::map<Link, double>>& current_flow_routing,
    double total_bandwidth_mhz,
    double max_power_per_node,
    double noise_density_dbm_per_mhz
) {
    OptimizationResult result;

    // =========================================================
    // 1. Topology Activation Census
    // =========================================================
    std::set<Link> active_network_edges;
    std::map<int, int> node_out_degrees;
    
    for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
        for (const auto& pair : current_flow_routing[k]) {
            if (pair.second > 1e-6) {
                active_network_edges.insert(pair.first);
            }
        }
    }
    
    for (const auto& link : active_network_edges) {
        node_out_degrees[link.first]++;
    }

    // =========================================================
    // 2. Uniform Bandwidth Allocation
    // =========================================================
    double uniform_bandwidth = active_network_edges.empty() ? 0.0 : total_bandwidth_mhz / static_cast<double>(active_network_edges.size());

    // =========================================================
    // 3. Heuristic Power Distribution & Shannon Capacity
    // =========================================================
    result.optimal_bandwidths.resize(edge_list.size(), 0.0);
    result.optimal_powers.resize(edge_list.size(), 0.0);
    result.optimal_rates.resize(edge_list.size(), 0.0);

    double noise_power_spectral_density_w_mhz = std::pow(10.0, (noise_density_dbm_per_mhz - 30.0) / 10.0);
    double total_noise_power_watts = noise_power_spectral_density_w_mhz * uniform_bandwidth;

    for (std::size_t i = 0; i < edge_list.size(); ++i) {
        Link current_link = { static_cast<int>(std::get<0>(edge_list[i])), static_cast<int>(std::get<1>(edge_list[i])) };

        if (active_network_edges.count(current_link)) {
            double uniform_power = max_power_per_node / static_cast<double>(node_out_degrees[current_link.first]);

            // --- Physical Layer Computations ---
            double distance_meters = std::get<2>(edge_list[i]);
            double distance_km = std::max(0.001, distance_meters / 1000.0);

            double path_loss_db = 128.1 + 37.6 * std::log10(distance_km);
            double channel_gain = std::pow(10.0, -path_loss_db / 10.0);

            double link_capacity_mbps = 0.0;
            
            // Zero-division defense: Calculate Shannon rate only if bandwidth (and thus noise power) is valid
            if (total_noise_power_watts > 1e-15) {
                double signal_to_noise_ratio = (uniform_power * channel_gain) / total_noise_power_watts;
                link_capacity_mbps = uniform_bandwidth * std::log2(1.0 + signal_to_noise_ratio);
            }

            result.optimal_bandwidths[i] = uniform_bandwidth;
            result.optimal_powers[i] = uniform_power;
            result.optimal_rates[i] = link_capacity_mbps;
        }
    }

    // =========================================================
    // 4. System-Wide Telemetry & SPFA Delay Auditing
    // =========================================================
    double system_max_delay = 0.0;
    double total_system_energy = 0.0;
    
    std::vector<double> edge_transmission_times(edge_list.size(), 0.0);
    std::vector<double> edge_traffic_loads(edge_list.size(), 0.0);

    for (std::size_t i = 0; i < edge_list.size(); ++i) {
        Link current_link = { static_cast<int>(std::get<0>(edge_list[i])), static_cast<int>(std::get<1>(edge_list[i])) };
        
        if (active_network_edges.count(current_link)) {
            double aggregated_link_traffic = 0.0;
            
            for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
                auto iterator = current_flow_routing[k].find(current_link);
                if (iterator != current_flow_routing[k].end() && iterator->second > 1e-9) {
                    double traffic_volume = std::get<2>(commodity_demands[k]);
                    aggregated_link_traffic += iterator->second * traffic_volume;
                }
            }
            edge_traffic_loads[i] = aggregated_link_traffic;

            double allocated_rate = result.optimal_rates[i];
            double allocated_power = result.optimal_powers[i];

            if (aggregated_link_traffic > 1e-9) {
                if (allocated_rate > 1e-9) { 
                    double transmission_time = aggregated_link_traffic / allocated_rate;
                    edge_transmission_times[i] = transmission_time;
                    total_system_energy += allocated_power * transmission_time;
                } else {
                    // Catastrophic Congestion: Traffic exists but rate is near-zero. Apply strict penalty.
                    edge_transmission_times[i] = 99999.0;
                    total_system_energy += allocated_power * 500.0;
                }
            } else {
                edge_transmission_times[i] = 0.0;
            }
        }
    }

    std::vector<double> commodity_max_delays(commodity_demands.size(), 99999.0);

    // Execute SPFA Topological Audit to compute exact end-to-end delays per commodity
    for (std::size_t k = 0; k < commodity_demands.size(); ++k) {
        int source_node = static_cast<int>(std::get<0>(commodity_demands[k]));
        int target_node = static_cast<int>(std::get<1>(commodity_demands[k]));
        double traffic_volume = std::get<2>(commodity_demands[k]);

        std::map<int, std::vector<std::pair<int, double>>> subgraph_adjacency;
        std::set<int> active_subgraph_nodes;

        for (std::size_t i = 0; i < edge_list.size(); ++i) {
            Link current_link = { static_cast<int>(std::get<0>(edge_list[i])), static_cast<int>(std::get<1>(edge_list[i])) };
            
            if (current_flow_routing[k].count(current_link) && current_flow_routing[k].at(current_link) > 1e-9) {
                int u = current_link.first;
                int v = current_link.second;

                double commodity_link_traffic = current_flow_routing[k].at(current_link) * traffic_volume;
                double traffic_share_ratio = commodity_link_traffic / edge_traffic_loads[i];
                double commodity_link_delay = traffic_share_ratio * edge_transmission_times[i];

                subgraph_adjacency[u].push_back({ v, commodity_link_delay });
                active_subgraph_nodes.insert(u);
                active_subgraph_nodes.insert(v);
            }
        }

        if (active_subgraph_nodes.empty()) continue;

        // --- SPFA Loop Detection and Delay Propagation ---
        std::map<int, double> arrival_times;
        std::queue<int> eval_queue;
        std::map<int, bool> in_queue;
        std::map<int, int> visit_counts;

        for (int node : active_subgraph_nodes) {
            arrival_times[node] = -1.0;
            in_queue[node] = false;
            visit_counts[node] = 0;
        }

        arrival_times[source_node] = 0.0;
        eval_queue.push(source_node);
        in_queue[source_node] = true;
        visit_counts[source_node] = 1;

        bool routing_loop_detected = false;

        while (!eval_queue.empty()) {
            int u = eval_queue.front();
            eval_queue.pop();
            in_queue[u] = false;

            for (const auto& edge : subgraph_adjacency[u]) {
                int v = edge.first;
                double delay_ij = edge.second;

                if (arrival_times[u] + delay_ij > arrival_times[v] + 1e-9) {
                    arrival_times[v] = arrival_times[u] + delay_ij;

                    if (!in_queue[v]) {
                        eval_queue.push(v);
                        in_queue[v] = true;
                        visit_counts[v]++;

                        if (visit_counts[v] > static_cast<int>(active_subgraph_nodes.size())) {
                            routing_loop_detected = true;
                            break;
                        }
                    }
                }
            }
            if (routing_loop_detected) break;
        }

        // --- Destination Audit & Penalty Assessment ---
        if (routing_loop_detected) {
            std::cout << "[Audit Warning] Flow " << k << " (Static-Alloc) trapped in a routing loop!\n";
            system_max_delay = std::max(system_max_delay, 99999.0);
            commodity_max_delays[k] = 99999.0;
        } 
        else if (arrival_times.count(target_node) && arrival_times[target_node] > -0.5) {
            double final_commodity_delay = arrival_times[target_node];
            commodity_max_delays[k] = final_commodity_delay;

            if (final_commodity_delay > system_max_delay) {
                system_max_delay = final_commodity_delay;
            }
        } 
        else {
            std::cout << "[Audit Warning] Flow " << k << " (Static-Alloc) failed to reach its destination!\n";
            system_max_delay = std::max(system_max_delay, 99999.0);
            commodity_max_delays[k] = 99999.0;
        }
    }

    result.max_end_to_end_delay = system_max_delay;
    result.max_expected_sum_delay = system_max_delay; 
    result.total_system_energy = total_system_energy;
    result.commodity_max_delays = std::move(commodity_max_delays);

    return result;
}

