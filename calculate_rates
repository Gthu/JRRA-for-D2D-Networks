#include <algorithm>
#include <cmath>
#include <cstddef>
#include <map>
#include <set>
#include <vector>

#include "graph.h"

/**
 * @brief Computes the Shannon capacity rates for all physical links based on the 3GPP path loss model.
 * * @param graph The underlying network topology.
 * @param num_nodes Total number of nodes in the network.
 * @param active_edges The subset of edges currently active in the routing topology.
 * @param bandwidth_allocations Current bandwidth allocation mapping (MHz) for active edges.
 * @param power_allocations Current power allocation mapping (Watts) for active edges.
 * @param noise_density_dbm_per_mhz Additive White Gaussian Noise (AWGN) power spectral density.
 * @param total_edge_count Total number of physical edges, used to estimate potential bandwidth.
 * @param total_bandwidth_mhz The total spectrum bandwidth available in the system.
 * @param node_max_powers Vector containing the maximum transmission power limit for each node.
 * * @return LinkMap A mapping of every valid link in the graph to its computed capacity (Mbps).
 * * @note Implements the 3GPP path loss formula: PL(dB) = 128.1 + 37.6 * log10(d_km). 
 * For inactive edges, the function assigns an optimistic resource estimation (uniform fractional bandwidth 
 * and maximum node power) to allow the shortest-path algorithm (Dijkstra) to discover potential new routes.
 * Time complexity is O(V + E) where V is the number of nodes and E is the total edge count.
 */
LinkMap calculate_rates(
    const Graph& graph,
    std::size_t num_nodes,
    const std::set<Link>& active_edges,
    const LinkMap& bandwidth_allocations,
    const LinkMap& power_allocations,
    double noise_density_dbm_per_mhz,
    std::size_t total_edge_count,
    double total_bandwidth_mhz,
    const std::vector<double>& node_max_powers
) {
    // 1. Convert Noise Power Spectral Density from dBm/MHz to linear scale (Watts/MHz)
    const double noise_power_spectral_density_w_mhz = std::pow(10.0, (noise_density_dbm_per_mhz - 30.0) / 10.0);
    
    // Fractional bandwidth assigned to an inactive edge for optimistic exploration
    const double optimistic_bandwidth_fraction = 1.0 / static_cast<double>(total_edge_count);
    
    LinkMap calculated_rates;

    for (std::size_t u = 0; u < num_nodes; ++u) {
        // Boundary safety check
        if (u >= graph.adj.size()) {
            continue;
        }

        for (const auto& edge : graph.adj[u]) {
            int v = edge.first;            
            double distance_meters = edge.second; 

            Link link = {static_cast<int>(u), v};

            double allocated_bandwidth_mhz = 0.0;
            double transmit_power_watts = 0.0;

            // --- Core Logic: Differentiate Active vs. Inactive Links ---
            if (active_edges.count(link)) {
                // [Case A] Active Edge: Utilize currently assigned physical resources.
                if (bandwidth_allocations.count(link)) {
                    allocated_bandwidth_mhz = bandwidth_allocations.at(link);
                }
                if (power_allocations.count(link)) {
                    transmit_power_watts = power_allocations.at(link);
                }
            } else {
                // [Case B] Inactive Edge: Optimistic resource estimation.
                allocated_bandwidth_mhz = total_bandwidth_mhz * optimistic_bandwidth_fraction;
                
                if (u < node_max_powers.size()) {
                    transmit_power_watts = node_max_powers[u];
                } else {
                    transmit_power_watts = 1.0; // Fallback to prevent math errors
                }
            }

            // Numerical safeguards against log(0), division by zero, or extreme proximity
            if (allocated_bandwidth_mhz <= 1e-9) allocated_bandwidth_mhz = 1e-9;
            if (transmit_power_watts <= 1e-9) transmit_power_watts = 1e-9;
            if (distance_meters <= 1e-9) distance_meters = 1.0; 

            // --- Physical Layer Computations ---

            // (a) 3GPP Path Loss Computation
            double distance_km = distance_meters / 1000.0;
            if (distance_km < 0.001) {
                distance_km = 0.001; 
            }
            double path_loss_db = 128.1 + 37.6 * std::log10(distance_km);

            // (b) Channel Gain (Linear Scale)
            double channel_gain = std::pow(10.0, -path_loss_db / 10.0);

            // (c) Total Thermal Noise Power
            double total_noise_power_watts = noise_power_spectral_density_w_mhz * allocated_bandwidth_mhz;

            // (d) Signal-to-Noise Ratio (SNR)
            double signal_to_noise_ratio = (transmit_power_watts * channel_gain) / total_noise_power_watts;

            // (e) Shannon Capacity: R = B * log2(1 + SNR) (Mbps)
            // Note: Maintained original division by log(2.0) to strictly guarantee zero logic alteration.
            double link_capacity_mbps = allocated_bandwidth_mhz * (std::log(1.0 + signal_to_noise_ratio) / std::log(2.0));

            calculated_rates[link] = link_capacity_mbps;
        }
    }

    return calculated_rates;
}
