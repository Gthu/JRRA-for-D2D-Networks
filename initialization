/**
 * @brief Extracts the unique set of active physical links from a collection of routing paths.
 * @param aggregated_paths A vector of computed network paths.
 * @return std::set<Link> The unique subset of edges forming the active routing topology.
 * @note Iterates through all multi-commodity paths to construct the foundational set of active links. 
 * Time complexity is O(P * L), where P is the number of paths and L is the average path length.
 */
std::set<Link> extract_active_subgraph_edges(const std::vector<GraphPath>& aggregated_paths) {
    std::set<Link> active_subgraph_edges;
    for (const auto& path : aggregated_paths) {
        if (path.size() < 2) continue;
        for (std::size_t i = 0; i < path.size() - 1; ++i) {
            int u = static_cast<int>(path[i]);
            int v = static_cast<int>(path[i + 1]);
            active_subgraph_edges.insert({ u, v });
        }
    }
    return active_subgraph_edges;
}

/**
 * @brief Initializes the network routing matrix using a K-Shortest Paths (KSP) uniform cold start.
 * @param graph The network topology graph.
 * @param topology_data The column generator containing edge definitions.
 * @param commodity_demands Traffic demand matrix.
 * @param num_nodes Total vertices in the graph.
 * @param max_power_per_node Maximum transmission power constraint applied uniformly to all nodes.
 * @param total_bandwidth_mhz The physical limit of total available spectrum in the system.
 * @param noise_density_dbm_per_mhz Additive White Gaussian Noise (AWGN) power spectral density.
 * @return InitializationResult Container with the constructed initial state mappings.
 * @note Splits traffic demands uniformly across up to K optimal paths. Initializes physical 
 * resource allocations (bandwidth and power) evenly among the resulting active links.
 */
InitializationResult initialize_with_ksp_uniform(
    const Graph& graph, 
    Col_gen topology_data,
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& commodity_demands,
    int num_nodes, 
    double max_power_per_node, 
    double total_bandwidth_mhz, 
    double noise_density_dbm_per_mhz
) {
    InitializationResult result;
    std::size_t demand_num = commodity_demands.size();
    result.flow_routing_matrix.resize(demand_num);
    std::vector<GraphPath> aggregated_paths;
    
    // Hyperparameters for path exploration
    const int max_exploration_paths = 10;
    const int target_k_paths = 3;

    std::cout << "\n>>> [Initialization] Strategy 1: KSP Uniform Cold Start...\n";

    // 1. KSP Routing and Uniform Traffic Splitting
    std::size_t demand_idx = 0;
    for (const auto& demand : commodity_demands) {
        std::size_t source_node = std::get<0>(demand);
        std::size_t target_node = std::get<1>(demand);
        
        auto [shortest_path, path_length] = dijkstra(graph, source_node, target_node);
        
        if (path_length != 0 || source_node == target_node) {
            auto multipath_set = k_shortest_paths(target_k_paths, shortest_path, max_exploration_paths, topology_data, graph, source_node);
            if (!multipath_set.empty()) {
                double split_ratio = 1.0 / static_cast<double>(multipath_set.size());
                
                for (const auto& path : multipath_set) {
                    if (path.size() < 2) continue;
                    for (std::size_t i = 0; i < path.size() - 1; ++i) {
                        Link current_link = { static_cast<int>(path[i]), static_cast<int>(path[i + 1]) };
                        result.flow_routing_matrix[demand_idx][current_link] += split_ratio;
                    }
                }
                aggregated_paths.insert(aggregated_paths.end(), multipath_set.begin(), multipath_set.end());
            }
        }
        demand_idx++;
    }

    // Retain an unadulterated baseline of the KSP routing
    result.initial_ksp_routing = result.flow_routing_matrix;

    // 2. Subgraph Extraction and Resource Allocation
    std::set<Link> active_subgraph = extract_active_subgraph_edges(aggregated_paths);
    std::vector<double> uniform_max_powers(num_nodes, max_power_per_node);

    InitialAllocation resource_alloc = initialize_resources(graph, active_subgraph, uniform_max_powers, total_bandwidth_mhz);
    result.active_edges = resource_alloc.active_edges;
    result.initial_power = resource_alloc.initial_power;
    result.initial_bandwidth = resource_alloc.initial_bandwidth;
    
    result.initial_rate_capacity = calculate_rates(
        graph, 
        num_nodes, 
        result.active_edges, 
        result.initial_bandwidth, 
        result.initial_power, 
        noise_density_dbm_per_mhz, 
        topology_data.edge_list.size(), 
        total_bandwidth_mhz, 
        uniform_max_powers
    );

    return result;
}

/**
 * @brief Initializes the network routing matrix using a K-Shortest Paths (KSP) with a Dual-Decomposition Warm Start.
 * @param graph The network topology graph.
 * @param topology_data The column generator containing edge definitions.
 * @param commodity_demands Traffic demand matrix.
 * @param num_nodes Total vertices in the graph.
 * @param max_power_per_node Maximum transmission power constraint applied uniformly to all nodes.
 * @param fairness_alpha The scaling parameter for the alpha-fairness utility function.
 * @param total_bandwidth_mhz The physical limit of total available spectrum in the system.
 * @param noise_density_dbm_per_mhz AWGN power spectral density.
 * @return InitializationResult Container with the intelligently mapped initial state mappings.
 * @note Replaces the uniform physical resource allocation with an intelligent mapping computed 
 * via Lagrangian Dual Decomposition (LDD), dramatically accelerating convergence in subsequent 
 * IPM or FW algorithms.
 */
InitializationResult initialize_with_ksp_warm(
    const Graph& graph, 
    Col_gen topology_data,
    const std::vector<std::tuple<std::size_t, std::size_t, double>>& commodity_demands,
    int num_nodes, 
    double max_power_per_node, 
    double fairness_alpha, 
    double total_bandwidth_mhz, 
    double noise_density_dbm_per_mhz
) {
    InitializationResult result;
    std::size_t demand_num = commodity_demands.size();
    result.flow_routing_matrix.resize(demand_num);
    std::vector<GraphPath> aggregated_paths;
    
    // Hyperparameters for path exploration
    const int max_exploration_paths = 10;
    const int target_k_paths = 3;

    // Fixed copy-paste artifact in the console output
    std::cout << "\n>>> [Initialization] Strategy 2: KSP Warm Start (Dual Decomposition)...\n";

    // 1. KSP Routing and Uniform Traffic Splitting
    std::size_t demand_idx = 0;
    for (const auto& demand : commodity_demands) {
        std::size_t source_node = std::get<0>(demand);
        std::size_t target_node = std::get<1>(demand);
        
        auto [shortest_path, path_length] = dijkstra(graph, source_node, target_node);
        
        if (path_length != 0 || source_node == target_node) {
            auto multipath_set = k_shortest_paths(target_k_paths, shortest_path, max_exploration_paths, topology_data, graph, source_node);
            if (!multipath_set.empty()) {
                double split_ratio = 1.0 / static_cast<double>(multipath_set.size());
                
                for (const auto& path : multipath_set) {
                    if (path.size() < 2) continue;
                    for (std::size_t i = 0; i < path.size() - 1; ++i) {
                        Link current_link = { static_cast<int>(path[i]), static_cast<int>(path[i + 1]) };
                        result.flow_routing_matrix[demand_idx][current_link] += split_ratio;
                    }
                }
                aggregated_paths.insert(aggregated_paths.end(), multipath_set.begin(), multipath_set.end());
            }
        }
        demand_idx++;
    }

    result.initial_ksp_routing = result.flow_routing_matrix;

    // 2. Core Upgrade: Execute Primal-Dual Algorithm (PDA) for Smart Warm Start
    std::cout << "[Init] Running PDA for Smart Resource Allocation based on KSP...\n";
    std::vector<double> uniform_max_powers(num_nodes, max_power_per_node);

    // Call LDD solver with the pre-computed KSP routing matrix
    auto smart_alloc = run_dual_decomposition_solver(
        topology_data.edge_list, 
        num_nodes, 
        uniform_max_powers, 
        total_bandwidth_mhz,
        commodity_demands, 
        result.initial_ksp_routing, 
        noise_density_dbm_per_mhz, 
        fairness_alpha, 
        1e-2 // convergence_epsilon
    );

    // 3. Mount LDD optimal solutions to the initial state structs (Vector -> LinkMap translation)
    result.initial_power.clear();
    result.initial_bandwidth.clear();
    result.initial_rate_capacity.clear();

    for (std::size_t i = 0; i < topology_data.edge_list.size(); ++i) {
        Link current_link = { static_cast<int>(std::get<0>(topology_data.edge_list[i])),
                              static_cast<int>(std::get<1>(topology_data.edge_list[i])) };

        // Safely map values back, defaulting to standard bounds to prevent mathematical faults
        result.initial_power[current_link] = (i < smart_alloc.optimal_powers.size()) ? smart_alloc.optimal_powers[i] : 0.0;
        result.initial_bandwidth[current_link] = (i < smart_alloc.optimal_bandwidths.size()) ? smart_alloc.optimal_bandwidths[i] : 1e-9;
        result.initial_rate_capacity[current_link] = (i < smart_alloc.optimal_rates.size()) ? smart_alloc.optimal_rates[i] : 1e-9;
    }

    // 4. Accurately reconstruct the active edge set strictly derived from KSP
    result.active_edges.clear();
    for (std::size_t k = 0; k < result.initial_ksp_routing.size(); ++k) {
        for (const auto& pair : result.initial_ksp_routing[k]) {
            if (pair.second > 1e-5) {
                result.active_edges.insert(pair.first);
            }
        }
    }

    return result;
}

